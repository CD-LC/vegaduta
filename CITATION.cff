cff-version: 1.2.0
message: "If you use VegaDūta in your research or work, please cite it as below."
title: "VegaDūta: an open-source multi-tenant platform for AI agents and workflows"
type: software
authors:
  - name: "The VegaDūta Authors"
repository-code: "https://github.com/CD-LC/vegaduta"
url: "https://github.com/CD-LC/vegaduta"
