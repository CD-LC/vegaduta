# VegaDūta root .gitignore. Component folders may add their own.
# Careful with bare directory names: web/app/build/ and */app/lib/ are source.

# --- Secrets and local environment ------------------------------------------
.env
.env.*
*.env
!.env.example
!.env*.example
!*.env.example
# Public repo identity (no secrets), read by scripts/dev/set-repo-identity.sh.
!scripts/dev/repo-identity.env
deploy/compose/.env
deploy/compose/.vegaduta-state
deploy/compose/.vegaduta-addons.json
deploy/compose/core.env
deploy/compose/google-oauth.env
*.pem
*.key
!**/src/test/**/*.pem
!**/src/test/**/*.key
sa-*.json
*-credentials.json
.gitleaks-report.json

# --- Agent / tool scratch ---------------------------------------------------
.claude/
scratchpad/
# ...but the real Java package of the same name in core/agents-tools is source,
# not scratch - a bare "scratchpad/" matches directories at any depth.
!core/agents-tools/src/**/scratchpad/
.aider*
.cursor/
.windsurf/

# --- Logs and crash dumps -----------------------------------------------------
*.log
logs/
hs_err_pid*.log
hs_err_*
replay_pid*.log
replay_*
*.stackdump
core.[0-9]*

# --- Java / Maven (core/) -----------------------------------------------------
target/
*.class
.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml
dependency-reduced-pom.xml
scripts/ci/flyway.lock

# --- Node / Next.js (web/, web-admin/, tests/e2e, Node services) ------------
node_modules/
.next/
/web/out/
# Generated by web/scripts/vendor-*.mjs (predev/prebuild) from node_modules.
/web/public/vendored/
/web-admin/out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/
playwright-report/
playwright-report-*/
test-results/
blob-report/
/playwright/.cache/

# --- Python (services/) -------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Build and release outputs --------------------------------------------------
/dist/
/sbom/
*.spdx.json
*.cdx.json
deploy/helm/**/charts/*.tgz
# tests/load/kind/gate.sh results (make load-gate)
/load-gate-out/

# --- Terraform --------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.lock.hcl.bak

# --- IDEs and OS ------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
# documentation site build (mkdocs)
site/
.venv-docs/

# local UI preview (web/dev/ui-preview/install.sh)
web/app/ui-kit/pv/
web/app/ui-kit/pv-lib/

# installer binary (built artifacts)
/installer/vegaduta-setup
/installer/vegaduta-setup.exe
/installer/dist/
# --- Internal reports and generated documents --------------------------------------
# Readiness, gap and walkthrough reports, test-run reports and slide exports are owner
# working files, not source. Keep them outside the repository (or under a name below).
/*.pdf
/*.docx
/*.pptx
tests/e2e/*-REPORT.md
tests/e2e/**/*-REPORT.md
.changes-private/
installer/installer
installer/vegaduta-setup-*

# SDK build artifacts
sdk/python-agent/dist/
sdk/python/dist/
sdk/typescript/dist/
web/node_modules/
sdk/typescript/node_modules/
