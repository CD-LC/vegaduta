# Copy to .env.local (Next.js auto-loads it, and it's already gitignored by
# the default Next.js .gitignore) and adjust if your Keycloak/core aren't at
# the defaults below. Every value here is NEXT_PUBLIC_* - baked into the
# browser bundle at build time, not a secret (the web console is a public
# OIDC client with no client secret - see agentic-ai-realm.json).

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=agentic-ai
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agentic-ai-web

# Razorpay checkout (Standard Checkout for payments)
# KEY_ID only - KEY_SECRET must NEVER be in frontend code
# Copy your test key ID from Razorpay dashboard (Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID

# Read directly in next.config.js (not NEXT_PUBLIC_ prefixed - these affect
# the build/dev-server itself, not client bundle code). Both optional / safe
# to leave unset for plain localhost dev.
# Production CDN hook for hashed static assets (Cloudflare/CloudFront/Vercel
# edge) - unset means assets are served from this app's own origin.
CDN_URL=
# Comma-separated hostnames (no scheme) the Next.js 15.3+ dev server should
# accept cross-origin dev requests from - needed when reaching dev through a
# Cloudflare Tunnel or similar, not needed for plain localhost.
ALLOWED_DEV_ORIGINS=

E2E_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
E2E_TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid-here
E2E_TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
E2E_TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
E2E_TWILIO_WHATSAPP_TO="whatsapp:+91-9742424300"

# code-intel microservice (standalone /code-intel preview page)
NEXT_PUBLIC_CODE_INTEL_URL=http://localhost:8090

# app-builder microservice (/build "App Builder" console). OPTIONAL and unset
# by default on purpose: app-builder is NOT part of deploy/docker-compose.yml,
# has no Caddy host route and no Cloudflare-tunnel hostname, so on the real
# deployment there is nothing for a browser to call. Leave this EMPTY and
# /build renders an honest "not available on this deployment" state and hides
# itself from the nav rail (web/app/build/lib.ts).
#
# Do NOT bake a localhost value into any deployed build - a hardcoded
# http://localhost:8091 default in web/app/build/lib.ts is exactly how the
# production "Failed to fetch ... http://localhost:8091" bug shipped, since
# NEXT_PUBLIC_* is compiled into the browser bundle (RULE 0 in CLAUDE.md).
# Only set the localhost form below for LOCAL dev where you are actually
# running app-builder/docker-compose.app-builder.yml on your own machine:
#   NEXT_PUBLIC_APP_BUILDER_URL=http://localhost:8091
# For a real deployment, publish app-builder on a public hostname (e.g.
# https://builder.<your-domain> - needs a reverse-proxy route + DNS first) and
# pass that as a build arg.
NEXT_PUBLIC_APP_BUILDER_URL=

# Public site identity (marketing/SEO). Leave unset for local dev.
# NEXT_PUBLIC_SITE_URL: canonical origin for metadataBase, sitemap, robots, JSON-LD.
# NEXT_PUBLIC_CONTACT_EMAIL: public contact address shown on the site.
# NEXT_PUBLIC_LEGAL_ENTITY / _LEGAL_CIN / _LEGAL_DIN: operator shown in the footer and /about
# (CIN/DIN are optional and hidden when empty).
# NEXT_PUBLIC_SITE_URL=https://example.com
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_CIN=
# NEXT_PUBLIC_LEGAL_DIN=

# scripts/indexnow.mjs (optional; skipped when unset)
# INDEXNOW_KEY=
# INDEXNOW_HOST=example.com
