{
  "name": "web",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/vendor-webllm.mjs && node scripts/vendor-kokoro.mjs && node scripts/vendor-babel.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/i18n-route-namespaces.mjs && node scripts/vendor-webllm.mjs && node scripts/vendor-kokoro.mjs && node scripts/vendor-babel.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test -c playwright.config.js",
    "e2e:ui": "playwright test -c playwright.config.js --ui",
    "e2e:report": "playwright show-report",
    "e2e:showcase": "playwright test -c playwright.config.js --headed -g \"Full platform showcase\"",
    "translate-messages": "node scripts/translate-messages.mjs",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "i18n:parity:check": "node scripts/i18n-parity.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mlc-ai/web-llm": "^0.2.85",
    "@radix-ui/react-accordion": "^1.2.17",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@react-spring/web": "^10.1.2",
    "@xyflow/react": "^12.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloak-js": "^25.0.6",
    "kokoro-js": "^1.2.1",
    "livekit-client": "^2.21.0",
    "lucide-react": "^0.469.0",
    "motion": "^12.42.2",
    "next": "^16.3.5",
    "onnxruntime-web": "^1.27.0",
    "pino": "^10.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/standalone": "7.26.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
