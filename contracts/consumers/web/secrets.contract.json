{
  "consumer": "web",
  "provider": "core",
  "interactions": [
    {
      "id": "get-api-secrets",
      "method": "GET",
      "path": "/api/secrets",
      "status": 200,
      "response": {
        "requiredFields": [
          "$[*].codeToolAccess",
          "$[*].createdAt",
          "$[*].createdBy",
          "$[*].description",
          "$[*].expired",
          "$[*].expiresAt",
          "$[*].id",
          "$[*].kind",
          "$[*].lastUsedAt",
          "$[*].name",
          "$[*].preview",
          "$[*].reference",
          "$[*].rotatedAt",
          "$[*].scope",
          "$[*].status",
          "$[*].updatedAt"
        ]
      }
    },
    {
      "id": "post-api-secrets",
      "method": "POST",
      "path": "/api/secrets",
      "status": 201,
      "response": {
        "requiredFields": [
          "$.codeToolAccess",
          "$.createdAt",
          "$.createdBy",
          "$.description",
          "$.expired",
          "$.expiresAt",
          "$.id",
          "$.kind",
          "$.lastUsedAt",
          "$.name",
          "$.preview",
          "$.reference",
          "$.rotatedAt",
          "$.scope",
          "$.status",
          "$.updatedAt"
        ]
      }
    },
    {
      "id": "delete-api-secrets-id",
      "method": "DELETE",
      "path": "/api/secrets/{id}",
      "status": 204,
      "response": {
        "requiredFields": []
      }
    },
    {
      "id": "put-api-secrets-id-allowed-hosts",
      "method": "PUT",
      "path": "/api/secrets/{id}/allowed-hosts",
      "status": 200,
      "request": {
        "requiredFields": [
          "$.allowedHosts"
        ]
      },
      "response": {
        "requiredFields": [
          "$.codeToolAccess",
          "$.createdAt",
          "$.createdBy",
          "$.description",
          "$.expired",
          "$.expiresAt",
          "$.id",
          "$.kind",
          "$.lastUsedAt",
          "$.name",
          "$.preview",
          "$.reference",
          "$.rotatedAt",
          "$.scope",
          "$.status",
          "$.updatedAt"
        ]
      }
    }
  ]
}
