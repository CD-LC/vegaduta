    {
      "id": "patch-api-mcp-registry-id",
      "method": "PATCH",
      "path": "/api/mcp/registry/{id}",
      "status": 200,
      "request": {
        "requiredFields": [
          "$.enabled"
        ]
      },
      "response": {
        "requiredFields": []
      }
    },
    {
      "id": "post-api-mcp-registry-id-connect",
      "method": "POST",
      "path": "/api/mcp/registry/{id}/connect",
      "status": 200,
      "response": {
