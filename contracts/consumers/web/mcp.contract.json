          "$[*].changedAt",
          "$[*].changedTools",
          "$[*].mode",
          "$[*].name",
          "$[*].observedHash",
          "$[*].pinned",
          "$[*].pinnedAt",
          "$[*].pinnedBy",
          "$[*].pinnedHash",
          "$[*].registrationId",
          "$[*].removed"
        ]
      }
    },
    {
      "id": "get-api-mcp-tool-pins-id",
      "method": "GET",
