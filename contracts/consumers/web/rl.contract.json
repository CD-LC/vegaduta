{
  "consumer": "web",
  "provider": "core",
  "interactions": [
    {
      "id": "get-api-rl-agents-agentId-export-trajectories",
      "method": "GET",
      "path": "/api/rl/agents/{agentId}/export/trajectories",
      "status": 200,
      "response": {
        "requiredFields": []
      }
    },
    {
      "id": "get-api-rl-agents-agentId-policies",
      "method": "GET",
      "path": "/api/rl/agents/{agentId}/policies",
      "status": 200,
      "response": {
        "requiredFields": []
      }
    },
    {
      "id": "put-api-rl-agents-agentId-policies-dimension",
      "method": "PUT",
      "path": "/api/rl/agents/{agentId}/policies/{dimension}",
      "status": 200,
      "response": {
        "requiredFields": [
          "$.dimension",
          "$.enabled",
          "$.explorationRate"
        ]
      }
    },
    {
