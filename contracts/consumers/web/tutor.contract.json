      "method": "GET",
      "path": "/api/tutor/plans",
      "status": 200,
      "response": {
        "requiredFields": [
          "$[*].completedLessons",
          "$[*].createdAt",
          "$[*].dueReviews",
          "$[*].goal",
          "$[*].id",
          "$[*].language",
          "$[*].level",
          "$[*].status",
          "$[*].topic",
          "$[*].totalLessons",
          "$[*].tutorAgentId",
          "$[*].updatedAt"
        ]
      }
    },
    {
      "id": "delete-api-tutor-plans-id",
