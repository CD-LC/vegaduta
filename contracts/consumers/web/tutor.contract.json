      "path": "/api/tutor/plans/{id}",
      "status": 204,
      "response": {
        "requiredFields": []
      }
    },
    {
      "id": "get-api-tutor-plans-id",
      "method": "GET",
      "path": "/api/tutor/plans/{id}",
      "status": 200,
      "response": {
