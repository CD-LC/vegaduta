(version 1)
;; VegaDuta MCP STDIO sandbox: deny by default, read-only except the data dir
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target self))
(allow sysctl-read)
(allow ipc-posix-shm-read-data)
(allow file-read*)
(deny file-read* (subpath "/Users/test/.ssh"))
(deny file-read* (subpath "/Users/test/.aws"))
(deny file-read* (subpath "/Users/test/.azure"))
(deny file-read* (subpath "/Users/test/.gnupg"))
(deny file-read* (subpath "/Users/test/.kube"))
(deny file-read* (subpath "/Users/test/.docker"))
(deny file-read* (subpath "/Users/test/.config/gcloud"))
(deny file-read* (subpath "/Users/test/.config/gh"))
(deny file-read* (subpath "/Users/test/.config/google-chrome"))
(deny file-read* (subpath "/Users/test/.config/chromium"))
(deny file-read* (subpath "/Users/test/.mozilla"))
(deny file-read* (subpath "/Users/test/.netrc"))
(deny file-read* (subpath "/Users/test/.npmrc"))
(deny file-read* (subpath "/Users/test/.pypirc"))
(deny file-read* (subpath "/Users/test/.git-credentials"))
(deny file-read* (subpath "/Users/test/.vegaduta"))
(deny file-read* (subpath "/Users/test/.config/op"))
(deny file-read* (subpath "/Users/test/.config/1Password"))
(deny file-read* (subpath "/Users/test/.claude"))
(deny file-read* (subpath "/Users/test/.zsh_history"))
(deny file-read* (subpath "/Users/test/.zsh_sessions"))
(deny file-read* (subpath "/Users/test/.bash_history"))
(deny file-read* (subpath "/Users/test/Library/Keychains"))
(deny file-read* (subpath "/Users/test/Library/Cookies"))
(deny file-read* (subpath "/Users/test/Library/Safari"))
(deny file-read* (subpath "/Users/test/Library/Mail"))
(deny file-read* (subpath "/Users/test/Library/Messages"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Google"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Firefox"))
(deny file-read* (subpath "/Users/test/Library/Application Support/BraveSoftware"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Microsoft Edge"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Chromium"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Arc"))
(deny file-read* (subpath "/Users/test/Library/Application Support/Vivaldi"))
(deny file-read* (subpath "/Users/test/Library/Application Support/com.operasoftware.Opera"))
(deny file-read* (subpath "/Users/test/Library/Application Support"))
(deny file-read* (subpath "/Users/test/Library/Group Containers"))
(deny file-read* (subpath "/Users/test/Library/Containers"))
(deny file-read* (subpath "/Library/Keychains"))
(deny file-read* (subpath "/private/etc/ssh"))
(allow file-read* (subpath "/Users/test/.vegaduta/mcp-package-cache/npm-cache/abc/sandbox"))
(allow file-write* (literal "/dev/null") (literal "/dev/dtracehelper"))
(allow file-write* (subpath "/Users/test/.vegaduta/mcp-package-cache/npm-cache/abc/sandbox"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.logd") (global-name "com.apple.diagnosticd") (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent") (global-name "com.apple.system.notification_center") (global-name "com.apple.system.logger") (global-name "com.apple.dnssd.service") (global-name "com.apple.SystemConfiguration.DNSConfiguration") (global-name "com.apple.SystemConfiguration.configd") (global-name "com.apple.trustd") (global-name "com.apple.trustd.agent") (global-name "com.apple.networkd") (global-name "com.apple.nsurlsessiond"))
(allow system-socket)
(allow network-outbound (remote tcp))
(allow network-outbound (remote udp "*:53"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(deny network-outbound (remote ip "localhost:*"))
