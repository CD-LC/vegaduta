  <properties>
    <!-- Java 21 (LTS). Raised from 17 to unlock virtual threads (Project Loom,
         stable since 21) for this heavily I/O-bound app - see
         spring.threads.virtual.enabled in application.yml and AgentChatService's
         preTurnExecutor. Spring Boot 3.4.x fully supports 21. Compiles on the
         JDK 24 already installed here (release 21 <= 24) and on the temurin-21
         build/runtime images (Dockerfile) and CI toolchains. Build JDK must be
         21+ - local builds whose JAVA_HOME still points at a 17 JDK need it
         repointed at 21+ (a 21+ JDK is already installed). -->
    <java.version>21</java.version>
    <spring-ai.version>1.1.8</spring-ai.version>
    <!-- Dependency upgrades for the release image scan (grype, fail on
         critical). Boot's managed tomcat/netty trail the fixed versions the
         scan requires; override the BOM properties rather than bumping the
         whole Boot release mid-cycle. -->
    <tomcat.version>10.1.59</tomcat.version>
    <netty.version>4.1.137.Final</netty.version>
    <!-- Same mechanism for the High advisories grype reports against the jars (fix available): Boot 3.5.16
         manages older releases of these, so the BOM properties are overridden. DependencyAdvisoryFloorTest
         (core/app) fails if a later change brings any of them back below the fixed release.
         jackson-bom 2.21.7 (jackson-core, jackson-databind): GHSA-p6pp-m3f8-5c89, GHSA-7hhh-6rmp-j9qf,
         GHSA-q4xh-88c3-wmh7, GHSA-cxp5-3px4-pw24, GHSA-wv8q-qhhj-9h54. jackson-annotations stays on the 2.22 pin
         in dependencyManagement below (the webauthn4j reason). -->
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <!-- httpcore5 and httpcore5-h2 5.4.3: GHSA-hf6x-8p5f-cgmf, GHSA-v3jc-474w-2wm6 (pulled by httpclient5 5.5.2) -->
    <httpcore5.version>5.4.3</httpcore5.version>
    <!-- PostgreSQL JDBC 42.7.12: GHSA-j92g-9f8w-j867 -->
    <postgresql.version>42.7.12</postgresql.version>
    <!-- Reproducible builds (JAVA-037): a fixed timestamp for every jar entry, so
         the same source always yields byte-identical jars (maven-jar-plugin and
         spring-boot-maven-plugin both honour it). Bump only when cutting a
         release if a human-meaningful date is wanted; any constant works. -->
    <project.build.outputTimestamp>2026-09-30T00:00:00Z</project.build.outputTimestamp>
    <!-- JaCoCo agent argLine, filled in by jacoco:prepare-agent. Must be defined
         (empty) so surefire's ${jacocoArgLine} resolves when the agent is skipped. -->
    <jacocoArgLine></jacocoArgLine>
    <!-- Extra JVM options appended to every test fork's argLine; empty by
         default. A module whose suite outgrows the JVM's default max heap (a
         quarter of physical RAM) overrides it in its own <properties>. -->
    <testForkJvmArgs></testForkJvmArgs>
    <jacoco.version>0.8.15</jacoco.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <!-- Git ref Spotless ratchets against. CI fetches origin/main (fetch-depth 0);
         a clone without that remote can pass -Dspotless.ratchet.ref=main (or HEAD). -->
    <spotless.ratchet.ref>origin/main</spotless.ratchet.ref>
    <archunit.version>1.5.1</archunit.version>
    <!-- JSpecify nullness annotations (@NullMarked/@Nullable). Compile-scope,
         annotation-only jar; the NullAway pilot in -Pstatic-analysis checks
         only packages marked @NullMarked. -->
    <jspecify.version>1.0.1</jspecify.version>
    <!-- Google Application Default Credentials: core/providers (Vertex AI) and core/dbauth (Cloud SQL IAM login)
         must use the same one. Managed in dependencyManagement below. -->
    <google-auth.version>1.54.0</google-auth.version>
    <webauthn4j.version>0.31.11.RELEASE</webauthn4j.version>
    <!-- Apache POI (documentgen writes DOCX/XLSX/PPTX; omnichannel reads the contacts XLSX).
         One version for both. 5.4.0 fixed the advisories that Dependabot alerts #5 and #6 list
         (CVE-2025-31672 among them); 5.5.1 is the latest 5.x. -->
    <poi.version>5.5.1</poi.version>
    <!-- testcontainers.version override removed in P1a (ADR-0012): Boot 3.5.16 manages
         Testcontainers 1.21.4 itself (the first 1.x that speaks to Docker Engine 29). -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.auth</groupId>
        <artifactId>google-auth-library-oauth2-http</artifactId>
        <version>${google-auth.version}</version>
      </dependency>
      <!-- Pin commons-io: twilio-sdk (core/omnichannel) pulls 2.14.0 and, being the nearest declaration, shadows the
           newer commons-io that Apache POI (core/documentgen) calls into (BoundedInputStream.builder(), 2.16+).
           Reading any .xlsx/.docx then throws NoSuchMethodError at runtime. Keep this at or above the commons-io
           that ${poi.version} declares (2.21.0 for POI 5.5.1): twilio is satisfied by any newer 2.x. -->
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.22.0</version>
      </dependency>
      <!-- Pin jackson-annotations 2.22: webauthn4j 0.31.x (passkeys, core/admin) parses with Jackson 3.2
           (tools.jackson), which calls JsonTypeInfo.Value.getWriteTypeIdForDefaultImpl(), a method added in
           annotations 2.22. Spring Boot's BOM manages 2.21, so without this pin the first passkey parse throws
           NoSuchMethodError. Annotations are backward compatible, so the 2.21 databind/core the rest of the
           reactor uses keeps working against 2.22. -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>2.22</version>
      </dependency>
      <!-- Pin lz4-java 1.11.4 (GHSA-mcr4-qmvw-px4g): kafka-clients 3.9.2 (spring-kafka, core/eventbus) pulls
           at.yawk.lz4:lz4-java 1.10.1, which Boot does not manage. Same drop-in fork, same API. -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.12.0</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Pin okhttp: spring-ai-google-genai (core/chat's
           GeminiAgentChatClientFactory) transitively pulls com.google.genai:
           google-genai, whose ApiClient.createHttpClient() calls
           OkHttpClient.Builder.connectTimeout(java.time.Duration) - an
           overload that only exists from OkHttp 4.0.0 onward. With no
           explicit okhttp version pinned anywhere in this reactor, Maven's
           nearest-wins mediation was letting some OTHER transitive
           dependency's older (pre-4.0, Duration-overload-less) okhttp shadow
           the one google-genai actually needs, producing a runtime
           NoSuchMethodError the first time a Gemini-backed call is made
           (reproduced via WorkflowController.generateGraph's AI workflow
           generator, but this would hit any Gemini call path). Explicit
           dependencyManagement entries win regardless of tree depth, so this
           fixes it no matter which dependency was actually "nearest". -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp</artifactId>
        <version>5.5.0</version>
      </dependency>
      <!-- OkHttp 5.x: the plain "okhttp" artifact is a KMP shell with no classes
           under Maven; okhttp-jvm carries them and is declared in core/chat.
           Its kotlin-stdlib floor (2.1.21) is also pinned because google-genai's
           older stdlib request would otherwise win mediation and OkHttp 5's
           Kotlin-2.1 bytecode can hit missing stdlib members at runtime. -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp-jvm</artifactId>
        <version>5.5.0</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>2.4.21</version>
      </dependency>

