  <build>
    <plugins>
      <!-- Java 21 migration: the build now REQUIRES a JDK 21+ (release 21 can't
           be produced by the JDK 17 this project used to pin to). On modern
           JDKs (21/24/25), Mockito/ByteBuddy's dynamic self-attach plus CDS
           sharing caused RANDOM per-run surefire fork crashes ("Unable to
           create test class 'X'", a different module each run) - flaky, not a
           code bug. These flags are the documented mitigation: allow the agent
           self-attach explicitly (silences the warning that becomes a hard
           error in newer JDKs) and disable class-data sharing (the source of the
           fork instability). IgnoreUnrecognizedVMOptions keeps this safe across
           every JDK 21+ variant even if one drops an option. Declared in
           <plugins> (not <pluginManagement>) so every child module inherits it
           for its own test forks. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacocoArgLine} ${testForkJvmArgs} -XX:+IgnoreUnrecognizedVMOptions -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
        </configuration>
      </plugin>

      <!-- Formatting (manual / CI only): NOT bound to any lifecycle phase; run
           "mvn spotless:check" (or spotless:apply). ratchetFrom limits it to
           files changed relative to origin/main so untouched code is never
           flagged. Existing code is 4-space indented with ASCII-sorted,
           ungrouped imports = google-java-format AOSP style. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <ratchetFrom>${spotless.ratchet.ref}</ratchetFrom>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Opt-in: keeping JaCoCo out of the default lifecycle means offline/CI builds
       never need the plugin resolved (prepare-agent runs at initialize and broke
       offline compiles when the plugin was not cached). Use: mvn -Pcoverage verify -->
  <profiles>
    <!-- Build-hygiene gates (maven-enforcer-plugin; version managed by the Boot
         parent). Active automatically in CI (GitHub Actions sets CI=true) and on
         demand with -Penforce. Kept out of the default local build only because
         the enforcer rule jars are not in every developer's offline ~/.m2, and
         `mvn -o` must keep working. Hard rules: JDK 21+, Maven 3.9+, no
         duplicate dependency declarations in a POM. dependencyConvergence is
         WARN-only (fail=false): Spring AI and the cloud SDK trees do not converge
         today; tighten once the report is clean. -->
    <profile>
      <id>enforce</id>
      <activation>
        <property>
          <name>env.CI</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-build-hygiene</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                    </requireJavaVersion>
                    <requireMavenVersion>
                      <version>[3.9,)</version>
                    </requireMavenVersion>
                    <banDuplicatePomDependencyVersions/>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>warn-dependency-convergence</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <fail>false</fail>
                  <rules>
                    <dependencyConvergence/>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Static analysis (OPT-IN via -Pstatic-analysis; CI runs it as its own
         step). Error Prone runs as a javac plugin with EVERY check demoted to a
         warning (-XepAllErrorsAsWarnings), so the general check set can never
         fail the build - see docs/engineering/ERROR-PRONE-BASELINE.md for the
         baseline histogram. The one exception is the NullAway pilot:
         OnlyNullMarked=true restricts NullAway to packages carrying
         @org.jspecify.annotations.NullMarked (package-info.java), and inside
         those packages a finding is an ERROR. Unmarked code is not checked at
         all, so marking a package is the (only) way to opt it in.
         fork=true + the -J add-exports/add-opens flags are the Error Prone
         Maven setup for JDK 16+ without a .mvn/jvm.config (keeps the default
         build untouched). -XDaddTypeAnnotationsToSymbol=true is required when
         the compiling JDK is 21 (CI) and a harmless no-op on 22+.
         Test sources get Error Prone but not NullAway (test classes share the
         pilot packages' names and would inherit @NullMarked). -->
    <profile>
      <id>static-analysis</id>
      <properties>
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.14.2</nullaway.version>
        <errorprone.common.args>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*[\\/]target[\\/]generated-(test-)?sources[\\/].*</errorprone.common.args>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <fork>true</fork>
              <showWarnings>true</showWarnings>
              <annotationProcessorPaths combine.children="append">
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${error-prone.version}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${nullaway.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
            <executions>
              <execution>
                <id>default-compile</id>
                <configuration>
                  <compilerArgs>
                    <arg>-XDcompilePolicy=simple</arg>
                    <arg>--should-stop=ifError=FLOW</arg>
                    <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                    <arg>-Xmaxwarns</arg>
                    <arg>100000</arg>
                    <arg>${errorprone.common.args} -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=false</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                  </compilerArgs>
                </configuration>
              </execution>
              <execution>
                <id>default-testCompile</id>
                <configuration>
                  <compilerArgs>
                    <arg>-XDcompilePolicy=simple</arg>
                    <arg>--should-stop=ifError=FLOW</arg>
                    <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                    <arg>-Xmaxwarns</arg>
                    <arg>100000</arg>
                    <arg>${errorprone.common.args} -Xep:NullAway:OFF</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                  </compilerArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <!-- Coverage (WARN-ONLY, OPT-IN via -Pcoverage): records coverage and writes target/site/jacoco
               per module, but enforces nothing. The agent argLine goes to
               ${jacocoArgLine} (not the default "argLine") so it composes with the
               surefire argLine above instead of being overridden by it.
               To turn on a coverage threshold later, add a third execution:
                 <execution><id>check</id><goals><goal>check</goal></goals>
                   <configuration><rules><rule><element>BUNDLE</element>
                     <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value>
                       <minimum>0.50</minimum></limit></limits></rule></rules>
                   </configuration></execution>
               (bound to verify by default); raise the minimum gradually. -->
            <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
