<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>agents-budget</artifactId>
  <name>agents-budget</name>
  <description>
    Per-user rolling spend budgets (com.agenticai.core.agents.budget: PerUserBudgetService,
    its tracking advisor and turn reservation guards, the agent BudgetPolicy embeddable) and
    tenant spend caps (com.agenticai.core.agents.spendcap). Cut out of agents; agents depends
    on this module, never the other way. The chat turn path calls it in-process (AGENTS.md
    rule 6). Depends on: chat, providers, security, tenancy, audit.
    See docs/architecture/agents-decomposition/budgets.md.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>providers</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <!-- BudgetPolicy is a JPA @Embeddable of Agent; SpendCapService reads through JdbcTemplate. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Both ledgers are Redis counters (StringRedisTemplate + Lua). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- PerUserBudgetTrackingAdvisor is a Spring AI Call/StreamAdvisor; Usage is spring-ai API. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
