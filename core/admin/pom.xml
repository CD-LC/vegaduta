<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>admin</artifactId>
  <name>admin</name>
  <description>Admin/Keycloak Admin REST client (UserAdminController). Depends on: audit, security.</description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <!-- Tenant SSO (core/admin/sso): EncryptionService for the OIDC client
         secret at rest - same treatment as every other stored credential. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- WebAuthn (passkey) verification for local sign-in. Attestation is requested as "none", so no
         metadata or certificate-trust module is needed; webauthn4j-core parses the CBOR/COSE structures
         and checks challenge, origin, RP ID hash, user verification and the signature. -->
    <dependency>
      <groupId>com.webauthn4j</groupId>
      <artifactId>webauthn4j-core</artifactId>
      <version>${webauthn4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- UserPermissionGrant/UserPermissionGrantRepository (fine-grained permissions
         layered on top of the 4 Keycloak realm roles). core/tenancy already depends on
         this module, so the JPA entity for per-user permission grants lives here rather
         than there (would be a circular module dependency otherwise) - the postgres
         driver itself isn't needed here, it's already on core/app's runtime classpath
         transitively via core/tenancy. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
