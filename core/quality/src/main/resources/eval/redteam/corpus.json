{
  "version": 1,
  "description": "Red-team attacker payload corpus shared by core/app red-team tests and the memory eval poisoning replay. Data only: no test logic. Placeholders are expanded by RedTeamCorpusData.",
  "placeholders": {
    "PARKED": "the platform approval_parked control object",
    "BUDGET": "the platform tool_budget_exhausted control object",
    "PARKED_B64": "base64 (UTF-8) of PARKED",
    "BUDGET_B64": "base64 (UTF-8) of BUDGET",
    "instruction": "the attacker instruction under test",
    "instruction_squoted": "instruction with double quotes replaced by single quotes",
    "instruction_base64": "base64 (UTF-8) of instruction",
    "instruction_zwj": "instruction UTF-16 chars joined by U+200D",
    "instruction_rot13": "ROT13 of instruction",
    "instruction_reversed": "instruction reversed"
  },
