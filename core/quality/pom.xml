<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>quality</artifactId>
  <name>quality</name>
  <description>
    Agent response quality evaluation framework. Automatic scoring of agent
    responses across multiple quality dimensions (helpfulness, accuracy, tone,
    length, relevance, safety) with historical tracking for dashboards and trend
    analysis. Per-plan feature gating (FREE tier: basic evals, PREMIUM: all evals).

    Uses LLM-as-judge for complex evaluations (JudgeChatClientFactory resolves
    a ChatClient from the tenant's own active BYOK provider, mirroring
    AssistService#buildChatClient) and heuristics for simple ones. When no
    judge is available, evaluations report an explicit UNAVAILABLE status -
    never a fabricated score. Evaluations run asynchronously to avoid
    blocking user-facing chat responses.

    Also hosts the standalone golden-dataset eval harness
    (com.agenticai.core.quality.eval, merged from the former core/eval
    module): a text-in/judge-out CLI runner (EvalRunner) invoked via
    exec:java, not wired into the Spring app. See eval-harness.md.

    Depends on: chat (LlmGatewayService), providers
    (ProviderCredentialResolver, ProviderModelCatalogService), security
    (TenantContext), tenancy.
    No dependencies on agents (to avoid circular dependency).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- The prompt registry: the model-facing text of this module is a registry key with a shipped default
         under src/main/resources/prompts/ and tenant/agent overrides (docs/prompts.md). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>prompts</artifactId>
    </dependency>
    <!-- The settings catalog: this module's entries (SettingsContributor) and SettingsResolver for its use sites
         (docs/settings.md). settings depends only on security and audit, so this adds no cycle. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>settings</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>reliability</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>providers</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- Per-agent access check for /api/agents/{id}/quality/** (B7). sharing sits below
         quality in the reactor and does not depend on agents, so no cycle. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>sharing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <!-- The eval harness (com.agenticai.core.quality.eval, merged from the old
         core/eval module) bare-constructs AnthropicChatModel/OpenAiChatModel
         itself - no Spring context, one-shot CLI run - so the plain model
         modules are declared here directly (same ADR-0012 P1a pattern core/chat
         uses), while the in-app quality evaluators still only need
         spring-ai-client-chat above. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
    </dependency>
    <!-- org.springframework.boot.convert.DurationStyle (EvalRunner). Arrives
         transitively via the starters; declared explicitly because the eval
         harness uses it directly. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Logging for the exec:java eval CLI run (runtime only; the in-app
         quality services get their backend from core/app). -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Standalone OpenTelemetry SDK for the eval harness: EvalRunner
         bootstraps OTel by hand (no Spring Boot autoconfiguration) so a CLI
         run still exports Langfuse spans exactly like the app's
         LlmMetricsAdvisor does. core/app already carries these transitively
         via micrometer-tracing-bridge-otel. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Runs the golden-dataset eval CLI via
           `mvn -pl quality -am compile exec:java` (see eval-harness.md for the
           full command + env vars) - not a Spring Boot fat-jar, this is a
           short-lived CLI script, not a service. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>com.agenticai.core.quality.eval.EvalRunner</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
