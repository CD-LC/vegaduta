<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>eventbus</artifactId>
  <name>eventbus</name>
  <description>
    Interactive Workflow Designer PRD, Phase 0 - the Kafka-backed event
    backbone (WorkflowEvent envelope, transactional outbox, outbox relay,
    a proof-of-pipe consumer). Everything here is inert unless the
    "workflow" Spring profile is active and app.workflow-events.enabled is
    true - see WorkflowEventPublisher's javadoc. Depends on: tenancy (for
    TenantSchemaIterator, used by the outbox relay to poll every tenant
    schema the same safe way every other scheduled job in this codebase
    already does).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- Direct dependency for TenantContext, even though tenancy already
         pulls it in transitively - matches the explicit-declare-what-you-
         import convention every other module in this codebase follows
         (e.g. omnichannel's pom.xml declares both tenancy and security). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <!-- #913/#914 (Kafka reliability hardening) - WorkflowEventOutboxRelay
         raises a PlatformIssue once a row dead-letters (retryCount reaches
         the cap). core/audit is a leaf module (no dependency back on
         eventbus/tenancy/etc.), so this is safe with no circular-dependency
         risk. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <!-- Tenant webhooks (V241): the signing secret is stored via
         EncryptionService, and delivery URLs are SSRF-screened by
         McpRemoteUrlGuard (the identical ruleset the platform already
         applies to remote MCP server URLs). Neither module depends on
         eventbus, so no cycle. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>mcp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Version managed by spring-boot-starter-parent's dependency
         management - no explicit version needed here, same as every other
         Spring Boot starter in this codebase's other module poms. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Infra audit (2026-07-27) - WorkflowEventOutboxRelay now registers a
         Gauge for pending/dead-lettered outbox depth. Version managed by
         spring-boot-starter-parent's dependency management, same convention
         as spring-kafka above. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
