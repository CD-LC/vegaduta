<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>app-worker</artifactId>
  <name>app-worker</name>
  <description>
    The dedicated Temporal workflow-worker deployable: same Maven modules and
    same configuration as `app` (via app-config), but booted as
    WorkerApplication - no REST controllers, no @Scheduled jobs, no Flyway,
    no per-tenant startup migration. Its only job is polling Temporal's
    task queue and executing workflow/node activities. This is the first
    independent deployable carved out of the modular monolith; see
    docs/plans/CORE-DECOMPOSITION-EXECUTION-PLAN-2026-09-23.md.

    Depends on the same modules `app` does (copy kept deliberately - if a
    module gains an activity-side dependency the worker needs it too), plus
    app-config. It does NOT depend on `app`: a repackaged Spring Boot jar
    is not a usable Maven dependency, and none of app's web-layer glue
    (GlobalExceptionHandler, WebConfig) is wanted here anyway.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>app-config</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>admin</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents</artifactId>
    </dependency>
    <!-- Chat turn path: AgentChatService, memory, hooks, context, skills, shares,
         the chat SSE endpoint (ADR-0023). In-process: a jar, not a network hop. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-turn</artifactId>
    </dependency>
    <!-- Tool layer: AgentToolProvider, resolvers, MCP connections, built-in tools,
         data tables (ADR-0023). Implements the agents tool ports the turn path calls,
         so every shape that runs turns loads it. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-tools</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-jobs</artifactId>
    </dependency>
    <!-- A2A, AG-UI, OpenAI-compatible endpoints, collaboration and crew hand-off tools,
         agent directory (ADR-0023). The delegation tools and the specialist hand-off run
         inside agent turns, so every shape that runs turns loads it. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-interop</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-browser</artifactId>
    </dependency>
