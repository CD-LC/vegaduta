    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-budget</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>approval</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>prompts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>settings</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>secrets</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>billing</artifactId>
    </dependency>
    <!-- UPI mandate payments. Used to arrive transitively through agents;
         since ADR-0011 moved the payment agent tools into payments (payments ->
         agents), every shape declares it directly to keep the same bean set. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>payments</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
