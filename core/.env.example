# core (Spring Boot) local dev env template.
#
# Copy this file to core/.env.local (already gitignored) and fill in real
# values. run-core.ps1 Set-Item's every KEY=VALUE line in .env.local into the
# session's env before starting core - this is what actually makes a value
# stick, since a manually-typed $env:VAR only lives in that one PowerShell
# window. Every var below is read via ${VAR:default} in
# core/app/src/main/resources/{application.yml, application-security.yml,
# application-knowledge.yml, application-workflow.yml, application-mcp.yml} -
# grep those files for the exact var name if you need to confirm where/how
# it's consumed. Anything with a default shown below is optional; anything
# marked REQUIRED has no default and core will either fail at boot or that
# feature will silently stay disabled until it's set.
#
# NOT listed here: LLM provider API keys (Anthropic/OpenAI/OpenRouter/Grok/
# Gemini/Sarvam), Twilio credentials, MCP server credentials. Those are all
# BYOK - entered through the web console UI and stored encrypted in Postgres
# per-tenant, never as env vars. See ProviderService/TwilioCredentialService/
# DynamicMcpConnectionManager if you're looking for where those actually live.

# ---------------------------------------------------------------------------
# Database (Postgres - shared with docker-compose's `postgres` service)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=agentic_ai
POSTGRES_USER=agentic
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis (session/cache - shared with docker-compose's `redis` service)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Encryption - REQUIRED. Generate once with: openssl rand -base64 32
# Do NOT regenerate once real encrypted rows (LLM provider keys, Twilio
# tokens, etc.) exist in the database - changing this key makes every
# previously-encrypted row permanently undecryptable, with no recovery path.
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32
# Only set during a deliberate key-rotation window (old key here, new key in
# APP_ENCRYPTION_KEY above) - leave blank otherwise.
APP_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Keycloak (identity/RBAC)
# ---------------------------------------------------------------------------
# REQUIRED - must be https in production/tunnel setups (Spring's JwtDecoder
# does a strict scheme-sensitive match against this).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/agentic-ai
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=agentic-ai
KEYCLOAK_CLIENT_ID=agentic-ai-core
# REQUIRED for /api/admin/** (user management) to work - paste from Keycloak:
# agentic-ai realm -> Clients -> agentic-ai-core -> Credentials tab.
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_A_REAL_ENVIRONMENT_DO_NOT_COMMIT_A_REAL_SECRET
# Docker-compose Keycloak container admin login + its own dedicated Postgres
# database (separate from the app's agentic_ai database - see
# deploy/docker-compose.yml's header comment).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme
KEYCLOAK_DB_NAME=keycloak

# ---------------------------------------------------------------------------
# S3-compatible object storage (MinIO for local dev, or real S3/R2 in prod)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=agentic-ai
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# true for MinIO/most S3-compatible services; false for Cloudflare R2.
STORAGE_PATH_STYLE_ACCESS=true

# ---------------------------------------------------------------------------
# LLM defaults
# ---------------------------------------------------------------------------
# Fallback model alias only - NOT a provider API key. Real provider keys are
# BYOK, entered via the Providers page, stored encrypted per-tenant.
DEFAULT_MODEL=claude-sonnet-5

# NOTE: WEB_ALLOWED_ORIGINS is intentionally NOT listed here. Web console CORS
# origins are hardcoded in application.yml's app.web.allowed-origins-list
# (see that file's comment) precisely so a stray WEB_ALLOWED_ORIGINS left over
# in some OS environment can never silently override it. If you're editing
# allowed origins, edit application.yml directly - setting this env var does
# nothing.

# ---------------------------------------------------------------------------
# Omnichannel - shared
# ---------------------------------------------------------------------------
# Public HTTPS base URL this core instance is reachable at - needed to
# reconstruct correct callback/webhook URLs for Twilio signature validation,
# etc. (e.g. a Cloudflare Tunnel hostname in local dev).
OMNICHANNEL_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Omnichannel - Discord Gateway bridge (NOT included in this repository)
# ---------------------------------------------------------------------------
# Discord sends work with just a bot token. RECEIVING Discord messages needs a separate
# Gateway bridge service that this repository does not ship; leave both values blank unless
# you run one (contract: docs/channels/discord.md). With both set, a private bridge address
# must also be listed in APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS.
DISCORD_GATEWAY_SERVICE_URL=
# One secret for both directions of the link; your bridge must send the same value.
DISCORD_GATEWAY_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (direct integration + Embedded Signup)
# developers.facebook.com -> your app -> WhatsApp -> Configuration
# ---------------------------------------------------------------------------
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_ANY_RANDOM_STRING_YOU_CHOOSE
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Must be a real HTTPS URL registered in the Meta app's Valid OAuth Redirect URIs.
META_EMBEDDED_SIGNUP_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Telegram (platform fallback bot - tenants can also bring their own token)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Public HTTPS base used when registering this bot's webhook with Telegram.
TELEGRAM_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Google OAuth (Drive/Gmail/Calendar/Sheets integration)
# console.cloud.google.com -> APIs & Services -> Credentials
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must point at core (backend), not the web console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback
GOOGLE_OAUTH_CONSOLE_REDIRECT_URI=http://localhost:3000/admin/integrations

# ---------------------------------------------------------------------------
# X (Twitter) OAuth
# developer.x.com -> your app -> User authentication settings
# ---------------------------------------------------------------------------
X_OAUTH_REDIRECT_URI=
X_OAUTH_CONSOLE_REDIRECT_URI=http://localhost:3000/admin/channels

# ---------------------------------------------------------------------------
# Signup rate limiting (Redis-backed)
# ---------------------------------------------------------------------------
SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Billing (Razorpay) - dashboard.razorpay.com -> Settings -> API Keys
# Test-mode only (rzp_test_ prefix) for local dev - never paste live-mode
# keys into a file that could be committed.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_BUSINESS=
RAZORPAY_TRIAL_DAYS=14

# ---------------------------------------------------------------------------
# Academy Fast-Track Scholarship one-click comp grant (CORE-COMP-GRANT-CONTRACT.md)
# Shared secret the Academy webapp sends in the X-Service-Token header on
# POST /api/tenant/comp-grant. Set the SAME value in the Academy's own env.
# Left blank => the endpoint fails closed and rejects every call.
# ---------------------------------------------------------------------------
CORE_COMP_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Guardrails / tool governance
# ---------------------------------------------------------------------------
GUARDRAILS_MAX_TOOL_CALLS_PER_TURN=15
# "semantic" (regex + LLM injection-classifier layer, default) or "pattern"
# (regex-only, explicit lighter-weight opt-out - zero extra LLM calls).
GUARDRAILS_IMPLEMENTATION=semantic
TOOL_AUTO_SELECTION_ENABLED=true
TOOL_AUTO_SELECTION_MAX_TOOLS=12
TOOL_MCP_DISCOVERY_CACHE_TTL_SECONDS=300
TOOL_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_BREAKER_WINDOW_MINUTES=5
TOOL_CIRCUIT_BREAKER_COOLDOWN_MINUTES=10

# ---------------------------------------------------------------------------
# Workflow engine, triggers, Temporal, Kafka/Redpanda events
# ---------------------------------------------------------------------------
WORKFLOW_TRIGGER_RATE_LIMIT_MAX=20
WORKFLOW_TRIGGER_RATE_LIMIT_WINDOW_MINUTES=10
# "legacy" (in-process, default) or "temporal" (durable, crash-resumable).
WORKFLOW_EXECUTION_ENGINE=legacy
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_RUN_TIMEOUT_SECONDS=600
# Opt-in - the Kafka/Redpanda event bus is off by default.
WORKFLOW_EVENTS_ENABLED=false
WORKFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# Translation job - "run now" trigger via GitHub Actions
# ---------------------------------------------------------------------------
GITHUB_REPO=
# Personal access token with repo + workflow scopes.
GITHUB_ACTIONS_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ---------------------------------------------------------------------------
# Approval retry backoff (HITL gate delivery retries)
# ---------------------------------------------------------------------------
APPROVAL_RETRY_MAX_ATTEMPTS=5
APPROVAL_RETRY_BASE_DELAY_SECONDS=30
APPROVAL_RETRY_MAX_DELAY_SECONDS=3600

# ---------------------------------------------------------------------------
# Knowledge base sidecar (Python embeddings service)
# ---------------------------------------------------------------------------
SIDECAR_BASE_URL=http://localhost:8001
# Sidecar internal auth (2026-08-07): SidecarClient sends this as
# X-Internal-Token on every call; must match the SAME value the sidecar
# itself runs with (deploy/.env's SIDECAR_SHARED_SECRET - openssl rand
# -hex 32). Blank sends no header, which only works against a sidecar
# started with SIDECAR_AUTH_REQUIRED=false (bare-local-dev escape hatch).
SIDECAR_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Code Intelligence (core/codeintel bridges to the standalone code-intel/
# microservice - see that folder's own README.md). OFF by default: with
# CODE_INTEL_ENABLED=false the CodeIntelClient bean is never created and
# AgentToolProvider's ObjectProvider lookup returns empty, so agents get no
# search_code/code_callers/code_impact/create_workspace/apply_files/run_code
# tools and nothing else changes. code-intel is operator-run infrastructure,
# not a per-tenant BYOK credential - one shared internal token, not a
# per-tenant key like Sarvam/E2B.
#
# The service supports THREE auth modes but only one is active at a time
# (CODE_INTEL_AUTH_MODE on the service itself, not here): "internal" is what
# core's CodeIntelClient speaks (X-Tenant-Id + this same shared secret as
# X-Internal-Token) - run the service with CODE_INTEL_AUTH_MODE=internal for
# the agent-tool integration below to work. The service also ships a
# standalone browser page (web/app/code-intel/, unlinked from the nav) that
# talks to it directly using the user's own Keycloak token instead
# (CODE_INTEL_AUTH_MODE=keycloak) - that's a separate, mutually exclusive way
# to run the same service, not something this app's config controls.
CODE_INTEL_ENABLED=false
CODE_INTEL_BASE_URL=http://localhost:8090
# Must exactly match the code-intel service's own CODE_INTEL_INTERNAL_TOKEN
# env var (generate with `openssl rand -hex 24`, same value both places).
CODE_INTEL_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# Workflow "email" output node / SMTP relay
# ---------------------------------------------------------------------------
WORKFLOW_MAIL_FROM=workflows@agentic-ai.local
# Leave SMTP_HOST blank to leave the "email" output node unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# MCP built-in tool servers (stdio subprocess commands)
# On Windows these are now defaulted to npx.cmd automatically by
# McpWindowsCommandEnvironmentPostProcessor (Java's CreateProcess can't spawn
# an extensionless "npx" - npm installs it as npx.cmd), so you no longer need
# to override them by hand. Set a value below only to point a connection at a
# different runtime or an absolute path - an explicit value here always wins.
# ---------------------------------------------------------------------------
MCP_FILESYSTEM_COMMAND=npx
MCP_FILESYSTEM_ROOT=./mcp-data
MCP_MEMORY_COMMAND=npx
MCP_SEQUENTIAL_THINKING_COMMAND=npx
MCP_PUPPETEER_COMMAND=npx
