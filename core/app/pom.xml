      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Prometheus metrics pipeline: the Micrometer Prometheus registry
         exposes Actuator's existing Micrometer metrics (JVM, HTTP server,
         HikariCP, etc. - all already collected once spring-boot-starter-
         actuator above is on the classpath) in Prometheus text format at
         /actuator/prometheus, which the deploy/prometheus/prometheus.yml
         scrape job (job "core") polls at core:8080. Version is managed by
         the spring-boot-starter-parent BOM (see core/pom.xml) - no explicit
         <version> needed, same convention every other starter/Micrometer
         artifact in this file already follows. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Tech-Stack-Audit-2026.md P3.1 / Master-Roadmap-2026.md item #9
         ("Langfuse tracing"). Both versions are managed by the
         spring-boot-starter-parent BOM (see core/pom.xml) - no explicit
         <version> needed, same convention every other Spring Boot starter
         in this file already follows. micrometer-tracing-bridge-otel wires
         Spring Boot's existing Micrometer Observation instrumentation
         (already active for HTTP requests via spring-boot-starter-actuator
         above, and for every ChatClient call via Spring AI's own built-in
         ChatClient/ChatModel observation support once this bridge is on the
         classpath) to produce real OpenTelemetry spans; opentelemetry-
         exporter-otlp ships them to management.otlp.tracing.endpoint (see
         application.yml) via OTLP/HTTP - Langfuse's native ingestion
         protocol as of v3.22+ (POST .../api/public/otel/v1/traces), so no
         Langfuse-specific SDK or custom span code is needed here at all. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
