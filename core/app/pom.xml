    <!-- Fraud-detection classes (common/security: AbuseDetectionService,
         HCaptchaClient, FraudAnalysisController, ...) use Lombok. Pinned
         ABOVE the spring-boot BOM's managed 1.18.36: that version predates
         JDK 24 support and silently produces no generated members (every
         `log`/getter reference fails to compile). 1.18.38 is the first
         release with JDK 24 support. Optional so it never lands on the
         runtime classpath. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.38</version>
      <optional>true</optional>
    </dependency>

