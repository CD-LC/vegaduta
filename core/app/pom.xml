  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- JDK 23+ removed classpath annotation-processor discovery, so a
               lombok jar on the classpath is never run and every generated
               member (log/getters/ctors) fails to compile. The explicit
               processor path works on both build JDKs in play (local 24 and
               the Dockerfile's temurin-21); -proc:full would too but the flag
               does not exist on 21. Version pinned, not BOM-managed.
               combine.children="append": keeps the Error Prone/NullAway paths
               the parent's -Pstatic-analysis profile adds (a child list
               otherwise replaces the inherited one). No-op without it. -->
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>1.18.38</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Explicit so `repackage` never scans target/classes for a unique
               main method - deterministic, and avoids an intermittent "Unable
               to find main class" when a fresh clean-build's class file is
               momentarily unreadable (Windows AV / JDK-24 timing). -->
          <mainClass>com.agenticai.core.CoreApplication</mainClass>
        </configuration>
        <executions>
          <!-- META-INF/build-info.properties -> BuildProperties bean (project
               version + build time) for GET /api/platform/version. The git SHA
               comes from the GIT_SHA env var baked in by core/Dockerfile instead
               of git-commit-id-maven-plugin (not resolvable offline here, and the
               Docker build context has no .git anyway). -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Unit-test run never touches the integration suite: *IT classes are
           outside surefire's default includes already, and the tag exclusion
           keeps any @Tag("integration") class out even if it is misnamed.
           Merged with the argLine inherited from core/pom.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>integration</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -P migrator ...: puts spring-boot-properties-migrator on the runtime
         classpath so a boot (or -Pit ApplicationContextIT) logs every renamed or
         removed configuration property with its replacement. NOT part of the
         default build and never shipped; ADR-0012 P1 uses it to clear property
         warnings before the Boot 4 hop. Version managed by the Boot parent. -->
    <profile>
      <id>migrator</id>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-properties-migrator</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- mvn -P it verify: runs the Testcontainers suite (MigrationsIT,
         ApplicationContextIT, KnowledgeVectorSearchIT) through failsafe after
         the unit tests. Needs a Docker daemon; each class is skipped (not
         failed) when none is reachable. Pass
         -Dvegaduta.test.postgres.image=<tag> to reuse a pre-built
         deploy/postgres image instead of building it on the fly. Failsafe's
         classesDirectory is pointed at target/classes by the Boot parent, so
         the repackaged fat jar is not on the test classpath. -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <argLine>@{jacocoArgLine} -XX:+IgnoreUnrecognizedVMOptions -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <groups>integration</groups>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
