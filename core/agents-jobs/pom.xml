<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>agents-jobs</artifactId>
  <name>agents-jobs</name>
  <description>
    Autonomous agent jobs (com.agenticai.core.agents.job and its sub-packages:
    schedules, event triggers, progress, durability, ownership, approval
    parking, structured output, sentinel, operator views), user scheduled tasks
    (com.agenticai.core.agents.scheduledtask plus the schedule_task tool) and
    deep-research runs (com.agenticai.core.agents.research, which are jobs).
    Split out of core/agents by ADR-0023; the Java packages are unchanged.

    Direction: agents-jobs depends on agents, never the reverse. Where agents
    needs something from here it owns a port and this module implements it:
    AgentJobLookup (job facts for the approval replay backstop and skill
    distillation), JobProgressRecorder (deep_research phase notes),
    ScheduleTaskToolFactory (the schedule_task tool) and
    ScheduledWorkflowRunner (implemented by core/workflow). AgentJobSession and
    ProgressSource are shared vocabulary and also stay in agents.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents</artifactId>
    </dependency>
    <!-- Agent jobs run turns through AgentChatService in core/agents-turn (ADR-0023). No cycle: agents-turn depends on agents only. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-turn</artifactId>
    </dependency>
    <!-- Research runs use the web search registry and the deep_research session
         and daily allowance (tools.web), which live in core/agents-browser
         (ADR-0023). agents-browser never depends on agents-jobs. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-browser</artifactId>
    </dependency>
    <!-- Declared explicitly for the "declare what you import" convention
         core/agents/pom.xml follows; all already reachable through agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>approval</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>rl</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>eventbus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>providers</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <!-- The settings catalog: approvals.continuation.* decide per workspace and agent whether a decided approval is carried
         into the parked job's resumed turn. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>settings</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>sharing</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- Structured job output (JobResultSchemaValidator / StructuredResultCoercer)
         compiles a tenant-authored JSON Schema. Moved here from core/agents with
         the code that imports it; same pinned version (2.0.0) that spring-ai's
         MCP client already pulls transitively.

         NOTE for anyone bumping this: 2.0.0 is an API BREAK from 1.x. The types
         are SchemaRegistry / Schema / Error / SpecificationVersion - NOT the
         JsonSchemaFactory / JsonSchema / ValidationMessage names every 1.x
         example on the internet uses. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <!-- The end-to-end approval harness (com.agenticai.core.agents.e2e) lives in agents-tools'
         test classes; the parked-job resume test runs the real job execution over it. Test scope
         only, and agents-jobs already depends on agents-tools through agents-browser, so no new
         module edge appears in the main dependency graph. In a profile that is off when tests are
         skipped (-Dmaven.test.skip=true, as the core image build does): agents-tools then makes no
         test jar, and a test-scope dependency on it would fail dependency resolution. -->
    <profile>
      <id>e2e-harness</id>
      <activation>
        <property>
          <name>!maven.test.skip</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.agenticai</groupId>
          <artifactId>agents-tools</artifactId>
          <version>${project.version}</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
