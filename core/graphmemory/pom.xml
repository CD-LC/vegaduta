<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>graphmemory</artifactId>
  <name>graphmemory</name>
  <description>
    Graph-based agent memory
    (Apache AGE, a Postgres extension - not a separate database) alongside
    AgentMemoryService's
    existing vector recall: entities/relationships extracted from remembered
    facts, multi-hop Cypher recall exposed as a tool. Depends on: tenancy
    (TenantSchemaResolver, same per-tenant-schema pattern
    AgentMemorySchemaSupport already uses for pgvector).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- EntityExtractionService / MemoryWriteArbitrationService parse model
         replies with chat's StructuredOutput helper. No cycle: chat's own
         closure (providers, knowledge, tenancy, ...) never depends on
         graphmemory; agents already depends on both. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- EntityExtractionService/GraphRecallToolCallback use Spring AI's
         ChatClient/ToolCallback types, same as knowledge's ToolCallbacks. -->
    <!-- Spring AI API only (ChatClient/advisors/ToolCallback/ChatModel types).
         Was spring-ai-starter-model-anthropic until 2026-09-28, but nothing in
         this module imports org.springframework.ai.anthropic (grep-verified,
         main + test); the provider starters and their auto-configs belong to
         core/chat, which builds every ChatModel. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- MemoryWriteArbitrationService decision/fallback counters. Version
         managed by the parent BOM; the registry itself is optional at runtime. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
