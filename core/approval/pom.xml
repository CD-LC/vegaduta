<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>approval</artifactId>
  <name>approval</name>
  <description>Human-in-the-loop approval gate + policy overrides + retry job. Depends on: audit, tenancy.</description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- Approval-gate hardening: ApprovalController derives the decision's
         audit attribution (decided_by) from TenantContext's JWT subject
         instead of trusting the request body. security was already on this
         module's compile classpath transitively (via tenancy and rl), but a
         direct compile-time dependency this class actually imports should be
         declared, not inherited by accident - a future prune of either of
         those would otherwise break this module's build. core/security has
         no internal dependencies of its own, so this cannot introduce a
         module cycle. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <!-- Approval-feedback -> RL reward loop (workbench fail-proof/learning
         hardening pass): a human's approve/reject decision on a workflow
         Approval node is training signal, folded into the same rl_episode
         pipeline core/agents already feeds from chat-UI thumbs/rating
         feedback - see HumanApprovalGateService's call to
         FeedbackService#recordApprovalDecision. rl is documented (see its
         own pom) as a one-directional leaf module meant to be depended ON
         by orchestrator-side callers via its published FeedbackService/
         RlTurnRecorder/RlPolicyPort seams - core/agents already takes this
         same dependency for the identical reason. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>rl</artifactId>
    </dependency>
    <!-- Tenant webhook emissions (V241): ApprovalRequestRecorder republishes
         approval lifecycle transitions through WorkflowEventPublisher so the
         approval.* events are subscribable like every other platform event.
         eventbus depends on tenancy/security/audit only - no dependency back
         on approval, so no module cycle. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>eventbus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- #640: ApprovalController reads Authentication.getAuthorities() to
         enforce an Approval node's "adminOnly" config server-side (not just
         a cosmetic UI picker) - spring-security-core is the smallest
         dependency that provides that type; the app's actual
         resource-server/JWT wiring lives in core/security and is already on
         the runtime classpath of the assembled app, this just makes
         Authentication resolvable at THIS module's compile time too. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
