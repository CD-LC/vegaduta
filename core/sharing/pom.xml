<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>sharing</artifactId>
  <name>sharing</name>
  <description>
    Cross-user resource sharing foundation: resource_grant table + ResourceAccessService
    (owner/admin/grant-based RUNNER/VIEWER/EDITOR access checks with anti-enumeration
    404-on-denial) that core/agents and core/workflow will retrofit onto Agent/
    WorkflowDefinition in a follow-up workstream. Depends on: audit, security, admin
    (KeycloakAdminClient - same-tenant grantee validation, the identical dependency
    UserAdminController already has it for). Deliberately has NO dependency on agents
    or workflow - see ResourceOwnerLookup's javadoc for how ShareController resolves a
    resource's owner without one.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>admin</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- ShareRateLimiter - the platform's standard Redis INCR+EXPIRE
           fixed-window limiter contract, declared directly (none of this
           module's other dependencies bring it in transitively), same as
           core/chat did for LlmGatewayRateLimiterService. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
