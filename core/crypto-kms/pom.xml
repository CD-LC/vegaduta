<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>crypto-kms</artifactId>
  <name>crypto-kms</name>
  <description>
    Cloud KeyManagementProvider implementations (AWS KMS, Azure Key Vault, GCP Cloud KMS) behind the
    crypto module's seam. A separate module so crypto stays a JDK-only leaf and only the assembly
    modules (app, app-jobs, app-worker) pull the cloud SDKs. Each provider is a bean only when
    app.crypto.kms.provider selects it, so its SDK classes are not loaded otherwise. The local
    provider (crypto) stays the default.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>crypto</artifactId>
    </dependency>
    <!-- JsonMappers: main code never constructs an ObjectMapper directly (JsonMappersUsageGuardTest). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- GuardedJdkHttpClient: the GCP KMS REST calls resolve through SsrfGuard
         (security is a leaf, no cycle). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- AWS KMS: GenerateDataKey / Decrypt. Default credential chain (IRSA, Pod Identity, instance role). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
      <exclusions>
        <!-- The assembly already ships the Apache client through the S3 dependency; Netty is not needed. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Azure Key Vault keys: wrapKey / unwrapKey. Same JDK-HTTP-client / no-Netty approach as core/storage. -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-security-keyvault-keys</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.azure</groupId>
          <artifactId>azure-core-http-netty</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-core-http-jdk-httpclient</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.azure</groupId>
          <artifactId>azure-core-http-netty</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- GCP Cloud KMS: the REST API over the JDK HttpClient; only the Application Default Credentials
         library (already shipped for Vertex AI in core/providers, same version) is needed. -->
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
      <version>1.54.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-sdk-bom</artifactId>
        <version>1.3.9</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.57.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
