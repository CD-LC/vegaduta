<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>knowledge</artifactId>
  <name>knowledge</name>
  <description>Hierarchical, multi-modal knowledge base (RAG), sidecar client, ingestion jobs, ToolCallbacks. Depends on: tenancy, crypto, security (SsrfGuard/SafeHttpClients for tenant-configured embedding endpoints).</description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- SSRF-guarded transports: OpenAiCompatibleEmbeddingClient's base URL is
         operator/tenant configuration, so its connections resolve through
         SsrfGuard (security is a leaf module - no cycle). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- OCR provider abstraction - OcrProviderConfigService encrypts the
         tenant's BYOK cloud-OCR API key at rest, same EncryptionService
         SarvamCredentialService/TwilioCredentialService use. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>crypto</artifactId>
    </dependency>
    <!-- Stage 5 (KB multi-modal storage) - FileStorageService, to keep the
         original uploaded file (pdf/image/audio/video) alongside its
         extracted text, the dependency core/storage's own module javadoc
         already called out as "expected to depend on this module next". -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>storage</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- KnowledgeSearchToolCallback/ListKnowledgeCollectionsToolCallback implement
         Spring AI's ToolCallback interface. -->
    <!-- Spring AI API only (ChatClient/advisors/ToolCallback/ChatModel types).
         Was spring-ai-starter-model-anthropic until 2026-09-28, but nothing in
         this module imports org.springframework.ai.anthropic (grep-verified,
         main + test); the provider starters and their auto-configs belong to
         core/chat, which builds every ChatModel. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
