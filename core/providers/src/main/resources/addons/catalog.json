    {
      "id": "tools",
      "name": "Tools runner (MCP servers)",
      "description": "Runs MCP tool servers (npx and uvx packages) in a separate container, away from your keys and database, so the Assistant can use them. A fresh install starts it and adds a clock connector; web fetch and step-by-step thinking are added switched off.",
