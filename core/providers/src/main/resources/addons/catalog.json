{
  "schemaVersion": 1,
  "addons": [
    {
      "id": "workspace",
      "name": "Build terminal and projects folder",
      "description": "Lets the Assistant create, run and test files in a projects folder on your computer. Commands run in a separate container that holds none of your secrets and has no access to Docker.",
      "category": "assistant",
      "kind": "compose-profile",
      "availability": "available",
      "sizeMb": 1350,
      "minRamMb": 3072,
      "needsGpu": false,
      "license": "Apache-2.0",
      "free": true,
      "requires": [],
      "defaultOn": true,
      "hostCommand": "./scripts/vegaduta personal --profile workspace",
      "learnMore": "docs/personal-mode.md#build-projects-with-the-assistant",
      "unlocks": ["assistant_terminal"],
      "model": null,
      "compose": { "profiles": ["workspace"], "flags": [], "env": {} },
      "observe": { "property": "app.assistant.local-shell.runner-url", "test": "non-blank" }
    },
    {
      "id": "search",
      "name": "Web search",
      "description": "A private search engine that runs next to VegaDūta, so agents can search the web without a search-API key. It asks public search engines for results on your behalf, so results depend on them and can occasionally be rate-limited.",
      "category": "search",
      "kind": "compose-profile",
      "availability": "available",
      "sizeMb": 377,
      "minRamMb": 512,
      "needsGpu": false,
      "license": "AGPL-3.0",
      "free": true,
      "requires": [],
      "defaultOn": false,
      "hostCommand": "./scripts/vegaduta personal --search",
      "learnMore": "docs/local-models.md#free-web-search",
      "unlocks": ["web_search"],
      "model": null,
      "compose": { "profiles": [], "flags": ["--search"], "env": {} },
      "observe": { "property": "app.web-search.searxng.base-url", "test": "non-blank" }
    },
    {
      "id": "documents",
      "name": "Documents and transcription",
      "description": "Reads PDFs and scanned pages, builds the index behind your documents, and turns audio and video into text. Adds a document-processing service, which is a large download.",
      "category": "documents",
      "kind": "compose-profile",
      "availability": "available",
      "sizeMb": 4140,
      "minRamMb": 2048,
      "needsGpu": false,
      "license": "Apache-2.0",
      "free": true,
      "requires": [],
      "defaultOn": false,
      "hostCommand": "./scripts/vegaduta personal --profile workspace --profile rag",
      "learnMore": "docs/personal-mode.md#start-with-one-command",
      "unlocks": ["documents", "transcription"],
      "model": null,
      "compose": { "profiles": ["rag"], "flags": [], "env": {} },
      "observe": { "property": "app.sidecar.enabled", "test": "true" }
    },
    {
      "id": "browser",
      "name": "Assistant browser",
      "description": "Lets the Assistant drive its own headless Chromium browser, which runs in a separate container so VegaDūta itself stays small; you sign in to a site once in a live view.",
      "category": "assistant",
      "kind": "compose-profile",
      "availability": "available",
      "sizeMb": 3400,
      "minRamMb": 2048,
      "needsGpu": false,
      "license": "Apache-2.0; Chromium: BSD-3-Clause",
      "free": true,
      "requires": [],
      "defaultOn": false,
      "hostCommand": "./scripts/vegaduta personal --browser",
      "learnMore": "docs/personal-mode.md#the-assistants-browser",
      "unlocks": ["browser_automation"],
      "model": null,
      "compose": { "profiles": [], "flags": ["--browser"], "env": {} },
      "observe": { "property": "app.browseruse.remote-url", "test": "non-blank" }
    },
    {
      "id": "model-qwen35-2b",
      "name": "Qwen 3.5 2B",
      "description": "A small local model for computers with 8 GB of memory. Good for quick chat and summaries. Downloaded into the Ollama that VegaDūta already uses.",
      "category": "models",
