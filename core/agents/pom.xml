<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>agents</artifactId>
  <name>agents</name>
  <description>
    The agents kernel: the Agent entity and settings, access, versioning,
    hosted-pool clients, quotas, guardrail and run-budget settings, DTOs,
    capabilities, trust, and the ports the split-out modules implement
    (ADR-0023). The chat turn path is in core/agents-turn and the tool layer
    in core/agents-tools; both depend on this module, never the reverse. The
    kernel reaches tools through tools.AgentToolPort. Shared vocabulary stays
    here: step events, the tool-call log, journals, tool classification,
    sandbox files, TurnContext and ChatTurnRequest (the turn's value types,
    which AgentToolPort takes).
    Depends on: chat, guardrails, providers, approval, knowledge, mcp, security.
  </description>

  <dependencies>
    <!-- Per-user budgets (PerUserBudgetService, BudgetPolicy) and tenant spend
         caps (spendcap) live in agents-budget; the turn path calls them
         in-process. The edge points down only: agents-budget never depends on
         agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-budget</artifactId>
    </dependency>
    <!-- ADR-0011 phase 4: the kernel-owned agent-tool ports (com.agenticai.core.agentspi)
         are their own module, so vendor modules can depend on them without depending on
         agents. agents consumes them; agentspi never depends on agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agentspi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>rl</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>guardrails</artifactId>
    </dependency>
    <dependency>
      <!--
        Admin Issues portal (#425/#426) - PlatformIssueService, called
        synchronously from LoggingToolCallback right where a failed tool
        call's error is already being captured for the tool_call_log row.
        "audit" is a leaf module (see its own pom.xml description) so this
        adds no new transitive dependency risk.
      -->
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <!-- Vault: CustomCodeToolService resolves a declared secret allow-list
         before the sandbox process starts, and redacts the resolved values out
         of result/stdout/stderr on the way back to the model. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>secrets</artifactId>
    </dependency>
    <!-- ADR-0011 phase 4 prep: the Google Workspace agent tools
         (com.agenticai.core.google.agenttools) now live in core/google, which
         depends on core/agentspi for the ports. agents must never
         depend on google again. -->
    <!-- ADR-0011 phase 4 prep: the Sarvam agent tools
         (com.agenticai.core.sarvam.agenttools) now live in core/sarvam, which
         depends on core/agentspi for the ports. agents must never
         depend on sarvam again. -->
    <!-- ADR-0011 phase 4 prep: the image/video generation agent tools
         (com.agenticai.core.imagegen.agenttools) now live in core/imagegen,
         which depends on core/agentspi for the ports. agents must never
         depend on imagegen again. -->
    <!-- ADR-0011 phase 4 prep: the ElevenLabs agent tools
         (com.agenticai.core.elevenlabs.agenttools) now live in core/elevenlabs,
         which depends on core/agentspi for the ports. agents must never
         depend on elevenlabs again. -->
    <!-- Master Roadmap 2026 item #14 fast-follow (#1071) - E2bRunCodeToolCallback
         (core.tools.e2b) wraps core/sdlc's SdlcSandboxService the same "native
         ToolCallback, not an MCP server" pattern Sarvam/imagegen/elevenlabs's
         tools already use above. No cycle: sdlc depends only on crypto/security/
         tenancy, never on agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>sdlc</artifactId>
    </dependency>
    <!-- Event-driven document generation (DOCX/PDF/XLSX/PPTX/CSV/TXT/MD/JSON) -
         GenerateDocumentToolCallback (core.tools.documentgen) wraps core/documentgen's
         DocumentGenerationService the same "native ToolCallback, not an MCP server"
         pattern Sarvam/imagegen/elevenlabs/sdlc's tools already use above. No cycle:
         documentgen depends only on tenancy/security/storage/eventbus, never on agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>documentgen</artifactId>
    </dependency>
    <!-- #596 fix: DynamicMcpConnectionManager.reconnectEnabledOnStartup needs
         TenantSchemaIterator (the standing utility every tenant-scoped
         @EventListener/@Scheduled job with no HTTP request/JWT must use - see
         its own javadoc) so a live MCP reconnect after a restart is done once
         per real tenant schema instead of silently only ever seeing the
         (empty) public schema. Already reachable transitively via google's
         own dependency on tenancy; declared directly here too since agents
         now calls it directly, not just transitively. No cycle: tenancy
         depends on admin/billing/security, never on agents/mcp/google. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- ADR-0011 phase 4 prep: the mandate-aware payment agent tools
         (com.agenticai.core.payments.agenttools) now live in core/payments,
         which depends on core/agentspi for the ports. agents must never
         depend on payments again. -->
    <!-- Chat turn events (AgentChatService / AgentMessageEvents) import
         com.agenticai.core.eventbus directly. The job event-trigger dispatcher
         that used to be the reason for this line moved to core/agents-jobs
         (ADR-0023). No cycle: eventbus depends on tenancy/security/audit only. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>eventbus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>providers</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>approval</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>codeintel</artifactId>
    </dependency>
    <!-- Graph-based memory
         (RememberFactToolCallback also writes extracted entities/relationships
         here; GraphRecallToolCallback exposes multi-hop recall as a tool). -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>graphmemory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>mcp</artifactId>
    </dependency>
    <!-- #157 follow-up ("agents should be able to execute commands, action
         and perform all activities") - the read_device_* tool callbacks
         (AgentToolProvider#resolveDeviceTools) read DeviceDataIngestionService/
         MobileDeviceRepository directly, the same "native ToolCallback, not
         an MCP server" pattern google's tools already use. No cycle: devices
         depends on tenancy/security only, never on agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>devices</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <!-- Stage 4 (Chat file upload): ChatAttachmentService stores/retrieves
         raw uploaded image/audio/video bytes via FileStorageService, the
         same S3-compatible object storage Storage Stage 3 introduced -
         that stage's own javadoc already named "chat file uploads" as the
         next planned caller. No cycle: storage depends only on crypto. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>storage</artifactId>
    </dependency>
    <!-- Cross-user resource sharing retrofit (Round 2) - ResourceAccessService/
         PermissionLevel/ResourceType/ResourceOwnerLookup, used by AgentService/
         AgentChatService/AgentGuardrailController/AgentReliabilityService/
         ChatAttachmentService to enforce RUNNER/VIEWER/EDITOR access on top of
         Agent.createdBy (migration V151). No cycle: sharing depends only on
         audit/security/admin, never on agents. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>sharing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- agents/memory/SessionMemoryService: Redis-backed conversation memory. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Spring AI API only (ChatClient/advisors/ToolCallback/ChatModel types).
         Was spring-ai-starter-model-anthropic until 2026-09-28, but nothing in
         this module imports org.springframework.ai.anthropic (grep-verified,
         main + test); the provider starters and their auto-configs belong to
         core/chat, which builds every ChatModel. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <!--
      Stage 4: MCP client support - autoconfigures a ToolCallbackProvider bean
      from spring.ai.mcp.client.* (see application-mcp.yml). AgentToolProvider
      (formerly in "tools") is what actually consumes this.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-client</artifactId>
    </dependency>
    <!-- Infra audit (2026-07-27) - FreeTierUsageLimiterService now registers a
         rejection Counter (message/token cap exceeded). Already reachable
         transitively via chat's own new micrometer-core dependency, but
         declared directly here too, same "explicit-declare-what-you-import"
         convention this file's own comments already call out (e.g. security
         above). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- Bouncy Castle (x402 signing) moved to core/agents-tools with tools.x402
         (ADR-0023). Nothing left in agents imports it. -->
    <!-- The Playwright dependency (browser-use tools) moved to core/agents-browser
         with tools.browseruse and tools.web (ADR-0023). Nothing left in agents
         imports it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
