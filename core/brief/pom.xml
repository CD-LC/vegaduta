<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>brief</artifactId>
  <name>brief</name>
  <description>
    Earned Autonomy foundation: the Brief - one declarative manifest (docs/plans/brief-schema.v1.json)
    for a whole solution (agents, workflows, tools, MCP servers, knowledge, secrets, channels, eval set,
    narrative, trust). This module plans a Brief from a prompt (BriefPlannerService), validates it
    (BriefValidator), reports what is missing before anything is created (BriefReadinessService), and
    persists it with versions (brief, brief_version, brief_apply_step, brief_binding, brief_trust_event
    in the tenant schema, migration V341). Apply, tune, rehearsal, trust and the proof ledger are later
    layers on top of these tables. Depends on: workflow (graph generator + OrchestratorService#validate),
    agents (AssistService, AgentService), secrets, mcp, knowledge, omnichannel, security, audit.
  </description>

