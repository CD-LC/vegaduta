<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>templates</artifactId>
  <name>templates</name>
  <description>
    Community template gallery: a sanitised, moderated, publicly-browsable catalogue of
    agent/workflow *designs* (community_template table, control-plane schema). Members
    submit a template built by an ALLOW-LIST snapshot of their own agent/workflow (system
    prompt, model/provider choice, tool names, guardrail settings, workflow graph - never
    keys, secrets, tenant ids, PII, or created_by), admins moderate (DRAFT -> PENDING ->
    APPROVED/REJECTED/WITHDRAWN), and approved templates are imported into any tenant as a
    brand-new agent/workflow via AgentService.create / WorkflowService.create. Depends on:
    audit (AuditLogService), security (TenantContext), agents + workflow (snapshot source
    entities + instantiation on import). Public gallery endpoints show APPROVED only and
    never leak config_json in the list. See this module's README.md and
    docs/COMMUNITY-TEMPLATES-CONTRACT-2026-07-30.md for the full contract.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents</artifactId>
    </dependency>
    <!-- Template generation uses AssistService in core/agents-turn (ADR-0023). No cycle: agents-turn depends on agents only. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-turn</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>workflow</artifactId>
    </dependency>
    <!-- DemoConversionAgentCopier implements core/tenancy's DemoArtifactCopier
         seam (demo->real-tenant agent carry-over on conversion). Reachable
         transitively via agents->tenancy, but declared directly per this repo's
         explicit-declare-what-you-import convention. No cycle: tenancy never
         depends on templates/agents/workflow. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- TemplateImportRateLimiter - the platform's standard Redis
           INCR+EXPIRE fixed-window limiter contract. Declared directly
           rather than leaning on the transitive path through core/agents,
           same as core/chat did for LlmGatewayRateLimiterService. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
