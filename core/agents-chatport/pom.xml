<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agenticai</groupId>
    <artifactId>core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>agents-chatport</artifactId>
  <name>agents-chatport</name>
  <description>
    Chat import/export (package com.agenticai.core.agents.chatport, name kept): importing
    ChatGPT / Claude / VegaDuta conversation exports (ChatImportParser and its per-format
    readers, ChatImportService, the imported_chat table), exporting a session as
    Markdown/JSON/text (ChatExportService, ChatExportRenderer) and the session transcript
    view. Extracted from core/agents (agents decomposition, see
    docs/architecture/agents-decomposition/chatport.md). Depends ON agents (Agent,
    AgentService, SessionMemoryService, MemoryImportService); nothing in agents may
    reference this module. REST paths, bean names, the JPA entity and its table are
    unchanged.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents</artifactId>
    </dependency>
    <!-- Chat export/import read and write session memory (agents.memory) in core/agents-turn (ADR-0023). No cycle: agents-turn depends on agents only. -->
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>agents-turn</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>audit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>sharing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Redis and tenancy are already on the classpath through agents (SessionMemoryService
         is Redis-backed); declared because the test helper InMemorySessionMemory, which
         moved here with its only callers, imports both directly. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.agenticai</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
