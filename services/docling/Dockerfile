# Same slim base family the repo standardizes on for Python services
# (services/sidecar/Dockerfile pins the exact patch+digest when one is chosen).
FROM python:3.12-slim

WORKDIR /app

# libGL/GLib: docling's OCR backends pull cv2 wheels (RapidOCR/EasyOCR ->
# opencv), and opencv needs these system libraries at import - without them the
# first image/PDF conversion fails despite `pip install` having succeeded.
# Same Python-wrapper-around-a-native-lib trap as the sidecar's tesseract-ocr.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# NOTE: unlike the sidecar this service has no requirements.lock yet - the
# hash-locked tree is generated by services/lock-requirements.sh the way
# services/sidecar/lock documents; add one before shipping if the project
# wants docling's transitive tree pinned with hashes too.
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

# Non-root runtime user, mirroring the sidecar. Docling downloads its
# layout/table/OCR model artifacts from Hugging Face at first use (several GB)
# into HF_HOME; the cache lives under /app so the unprivileged user can write
# it, and the models are baked at BUILD time so a deployment whose host blocks
# Hugging Face egress still converts on the first request - the same posture
# the sidecar takes for its sentence-transformers models. `docling-tools
# models download` is the upstream CLI for prefetching the default pipeline's
# artifacts. --build-arg BAKE_MODELS=false keeps a slim local/CI image that
# downloads on first use instead (README "Models").
ENV HF_HOME=/app/.cache/huggingface
ARG BAKE_MODELS=true
RUN groupadd -r docling && useradd -r -g docling docling \
    && mkdir -p /app/.cache \
    && if [ "$BAKE_MODELS" = "true" ]; then docling-tools models download; fi \
    && chown -R docling:docling /app
USER docling

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health', timeout=3)" || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
