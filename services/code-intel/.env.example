# code-intel — local dev environment. Copy to `.env` and adjust.
# Loaded by run-dev.sh (the service itself reads process env via os.environ).

# Auth: the /code-intel web page sends the user's Keycloak token, so use
# keycloak mode locally and allow the web origin through CORS.
CODE_INTEL_AUTH_MODE=keycloak
CODE_INTEL_KEYCLOAK_ISSUER=http://localhost:8180/realms/agentic-ai
# Which Keycloak clients' tokens are accepted (matched against the token's
# `azp` claim; missing/unlisted => 401). This is the default - uncomment only
# to change it. Without it any client in the realm (e.g. academy-webapp) could
# call this service (security audit 2026-09-18).
# CODE_INTEL_KEYCLOAK_ALLOWED_AZP=agentic-ai-web,agentic-ai-ide,agentic-ai-core
CODE_INTEL_CORS_ORIGINS=http://localhost:3000

# Where indexes/clones/workspaces live (created if missing).
CODE_INTEL_DATA_DIR=./data

# Embedding provider. Use "hash" for a zero-dependency smoke test; switch to
# "fastembed" once you've installed requirements.txt.
CODE_INTEL_EMBEDDER=fastembed
CODE_INTEL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Code execution / rework loop. OFF by default; turn on to use the
# "Execute & Rework" tab. Only enable where you accept running repo code.
CODE_INTEL_ALLOW_EXEC=false
CODE_INTEL_EXEC_TIMEOUT=300

# Only needed if you also call the service server-to-server (core / MCP
# bridge) with auth_mode=internal. Not required for the keycloak web path.
# CODE_INTEL_INTERNAL_TOKEN=change-me

# SDLC agent loop (POST /repos/{repo_id}/agent/resolve) — OPTIONAL, OFF.
# Its default planner is an Anthropic LLM; the key is read straight from the
# environment by the anthropic SDK, never stored or echoed by this service.
# Leave it unset unless you want the agent loop: without it the endpoint
# answers 503 naming the missing configuration, and indexing, search, the code
# graph and /knowledge/query all keep working normally.
# Two more things are true before the loop can actually run:
#   - `anthropic` is a COMMENTED-OUT optional line in requirements.txt, so it
#     is not in the image — install it as well as setting the key;
#   - the loop executes code, so it also needs CODE_INTEL_ALLOW_EXEC=true
#     above. On Azure Container Apps that stays false (no privileged
#     containers, so no Docker sandbox), and the key alone will not enable it
#     there.
# GET /health reports both gates under capabilities.agent_resolve.
# ANTHROPIC_API_KEY=
