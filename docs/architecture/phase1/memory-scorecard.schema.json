{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-scorecard.schema.json",
  "title": "VegaDuta memory scorecard",
  "description": "Report consumed by scripts/ci/memory-scorecard-gate.sh. See 04-measurement-scorecard.md, Addendum A.",
  "type": "object",
  "required": ["schemaVersion", "verdict", "gates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["SHIP", "SHIP DARK", "NO-SHIP"]},
    "memoryDefaultOn": {"type": "boolean", "default": false},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^G([1-9]|1[01])$"},
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "WARN", "UNPROVEN"]},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
