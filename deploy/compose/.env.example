# =============================================================================
# VegaDūta — deploy/compose/.env
#
# Generate your .env instead of editing this by hand:
#     ./scripts/vegaduta secrets        (Windows: .\scripts\vegaduta.ps1 secrets)
# That copies this file to .env and fills EVERY empty secret below with a
# random value. It never overwrites a value that is already set.
#
# Keep .env out of git (it is gitignored) and back it up together with your
# database volumes: without APP_ENCRYPTION_KEY a database backup is useless.
#
# Conventions
#   - Values left blank marked [secret] are generated by the installer.
#   - Values marked [optional] may stay blank; the feature stays off.
#   - Public URLs: localhost defaults are right for LITE / a single machine.
#     For a real server set BASE_DOMAIN and use docker-compose.domain.yml
#     (the CLI does both); the PUBLIC_* values are then derived from it.
# =============================================================================

# ----------------------------------------------------------------------------
# 1. Release & runtime
# ----------------------------------------------------------------------------
# Image tag for every first-party image (ghcr.io/cd-lc/<name>:<tag>),
# including the Postgres image. REQUIRED - there is no `latest` default, so
# the compose files, realm JSON and images always come from one release.
# Release tarballs ship with this line already set to their own version
# (the release workflow stamps it). In a git checkout, set a published
# release (see https://github.com/CD-LC/vegaduta/releases) or run
# `scripts/vegaduta up --build`, which builds from source and tags `local`.
# Change it only through `scripts/vegaduta upgrade --version X.Y.Z` (takes a
# database backup first).
VEGADUTA_VERSION=
VEGADUTA_REGISTRY=ghcr.io/cd-lc
# Postgres image with pgvector + Apache AGE (built from deploy/postgres).
# Empty = ${VEGADUTA_REGISTRY}/postgres:${VEGADUTA_VERSION}. [optional]
VEGADUTA_POSTGRES_IMAGE=
# Compose project name (prefixes containers/volumes). Leave empty to use the
# per-tier default: "vegaduta" (full) or "vegaduta-lite" (lite).
COMPOSE_PROJECT_NAME=
# Personal tier only: the compose project, set by `secrets` when Docker already holds an earlier
# personal install's data made with other secrets (kept untouched). Empty = "vegaduta-personal". [optional]
VEGADUTA_PERSONAL_PROJECT=
# Extra compose profiles to enable, comma-separated. Full stack:
# temporal,events,jobs,observability,tracing,voice,rl,code-intel,builder,sandbox,tools,browser
# Lite: rag,tools,workspace (personal: the same three plus browser).
# (The CLI's --profile flag adds to this.)
COMPOSE_PROFILES=
# Interface host ports bind to. 127.0.0.1 = this machine only (recommended;
# use the domain overlay / a reverse proxy for remote access).
BIND_ADDR=127.0.0.1

# ----------------------------------------------------------------------------
# 2. Public (browser-facing) URLs
# ----------------------------------------------------------------------------
# These are what a BROWSER uses. They must never point at an internal compose
# name (http://core:8080), and must not be localhost if users connect from
# other machines. Leave BASE_DOMAIN empty for local use.
# Core itself has NO built-in fallback for the values Compose derives from
# these (APP_WEB_PUBLIC_URL from PUBLIC_APP_URL, KEYCLOAK_ISSUER_URI from
# PUBLIC_AUTH_URL): the localhost values below are Compose's local-use
# defaults, and core refuses to start when either arrives empty.
BASE_DOMAIN=
# Email for Let's Encrypt (domain mode). [optional]
ACME_EMAIL=
# Empty = automatic HTTPS (Let's Encrypt). Otherwise a Caddy `auto_https` value: `off` if TLS is
# terminated by another proxy/tunnel in front of Caddy, or disable_redirects / disable_certs /
# ignore_loaded_certs. (`on` is not a valid value.)
CADDY_AUTO_HTTPS=
# Behind a tunnel or another TLS-terminating proxy: CADDY_AUTO_HTTPS=off and CADDY_SITE_SCHEME=http://
# (Caddy then serves plain HTTP on :80 for the proxy to forward to). Leave empty for Let's Encrypt.
CADDY_SITE_SCHEME=
# Host interface Caddy publishes 80/443 on. Default 0.0.0.0. In tunnel mode set 127.0.0.1 so the plain-HTTP
# port is not reachable around the tunnel. [optional]
# PUBLIC_BIND_ADDR=127.0.0.1

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_AUTH_URL=http://localhost:8180
# Browser-facing code-intel URL. Leave EMPTY to use the core proxy (recommended; a
# localhost value is baked into the browser bundle and breaks every non-local viewer).
PUBLIC_CODE_INTEL_URL=
# App Builder UI entry point (profile `builder`). [optional]
PUBLIC_BUILDER_URL=
# Academy learning portal (separate, proprietary deployable) linked from the
# header, footer and docs pages. Unset = the hosted academy.vegaduta.ai; point
# it at a self-hosted Academy if you run your own. [optional]
WEB_ACADEMY_URL=https://academy.vegaduta.ai
# Contact address on /plugins and /account-deletion. Empty = a placeholder; set an address you own. [optional]
WEB_CONTACT_EMAIL=
PUBLIC_LIVEKIT_URL=ws://localhost:7880
PUBLIC_LANGFUSE_URL=http://localhost:3002

# ----------------------------------------------------------------------------
# 3. Core platform secrets
# ----------------------------------------------------------------------------
# [secret] AES key for every stored provider API key, channel token and
# OAuth credential. 32 random bytes, base64 (openssl rand -base64 32).
# !!! GENERATE ONCE, NEVER CHANGE. A different key makes all stored secrets
# !!! undecryptable. Every process that boots core (compose, a bare
# !!! `mvn spring-boot:run`, Kubernetes) must use the SAME value.
APP_ENCRYPTION_KEY=
# [secret] Guards the platform-admin "delete tenant completely" control.
PLATFORM_MASTER_KEY=

# ----------------------------------------------------------------------------
# 4. PostgreSQL (app data; pgvector + Apache AGE)
# ----------------------------------------------------------------------------
# Bootstrap SUPERUSER: used only by the one-shot db-roles service, backups
# (scripts/vegaduta backup) and manual psql. Never handed to core.
POSTGRES_USER=agentic
POSTGRES_DB=agentic_ai
# [secret]
POSTGRES_PASSWORD=
# The login core uses: owner of POSTGRES_DB, NOT a superuser (no COPY ...
# PROGRAM, no file access). db-roles creates it on every `up` and adopts
# objects an older install created as the superuser. Setting it equal to
# POSTGRES_USER opts out (core keeps superuser access; not recommended).
POSTGRES_APP_USER=vegaduta_app
# [secret]
POSTGRES_APP_PASSWORD=

# ----------------------------------------------------------------------------
# 5. Valkey (Redis protocol cache / rate limits)
# ----------------------------------------------------------------------------
# [secret]
VALKEY_PASSWORD=

# ----------------------------------------------------------------------------
# 6. Keycloak (identity)
# ----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
# [secret] Keycloak master-realm admin (http://localhost:8180/admin).
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=agentic-ai
# [secret] Secret of the confidential `agentic-ai-core` client. Injected into
# the realm on FIRST import (deploy/keycloak/agentic-ai-realm.json uses
# ${env.KEYCLOAK_CLIENT_SECRET}); changing it later requires updating the
# client in the Keycloak admin console too.
KEYCLOAK_CLIENT_SECRET=
# Full stack: Keycloak runs in production mode (`start`) on its own
# PostgreSQL. `start-dev` is for local theme debugging only and is refused
# with BASE_DOMAIN set (the domain overlay always uses `start`). Lite always
# uses start-dev with an embedded store (localhost only). [optional]
KEYCLOAK_START_COMMAND=
# Full stack only (lite uses Keycloak's embedded dev-file store).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
# [secret]
KEYCLOAK_DB_PASSWORD=
# Require e-mail verification at sign-up. Only turn on once SMTP is set in
# the Keycloak realm (Realm settings -> Email), or nobody can finish signup.
KC_VERIFY_EMAIL=false
# Password grant ("direct access") on the confidential agentic-ai-core client,
# applied at first realm import. Off: nothing in the product needs it; CI's
# overlay turns it on for scripted test logins. [optional]
KC_CORE_DIRECT_GRANTS=false
# Issuer consistency: Keycloak stamps every token with PUBLIC_AUTH_URL/realms/
# <realm> (KC_HOSTNAME) and core validates exactly that issuer. If tokens can
# legitimately arrive with another issuer (e.g. during a domain migration, or
# a dev tool that talks to http://localhost:8180 while the public URL is a
# domain), list those extra issuers here, comma-separated. Missing a real
# issuer here = every API call 401s. [optional]
KEYCLOAK_ADDITIONAL_ISSUERS=
# Non-Keycloak OIDC issuers (Auth0, Microsoft Entra, Okta, ...): claim mapping.
# Keycloak deployments need none of these — the defaults ARE the Keycloak
# claim shapes. [optional]
# Dot-path to the roles/authorities claim (default: realm_access.roles).
# A flat or namespaced key works too, e.g. https://example.com/roles.
#OIDC_ROLES_CLAIM_PATH=
# Token claim that carries the tenant id (default: tenant_id).
#OIDC_TENANT_CLAIM=
# Claim carrying OAuth scopes, space-delimited string or list; empty = off
# (default). Scope authorities are additional, never a substitute for grants.
#OIDC_SCOPES_CLAIM=
# Auth0 as the identity provider (alternative to the bundled Keycloak):
# switches the user-admin surface (console user list, signup, onboarding)
# to Auth0's Management API. Token validation still needs
# KEYCLOAK_ISSUER_URI=https://<AUTH0_DOMAIN>/ and the OIDC_* claim mapping
# above. [optional]
#IDENTITY_PROVIDER=auth0
# The Auth0 tenant domain (e.g. my-tenant.eu.auth0.com).
#AUTH0_DOMAIN=
# [secret] A Machine-to-Machine application authorized against the Auth0
# Management API. Scopes needed: read:users, create:users, update:users,
# delete:users, read:roles, delete:sessions, delete:refresh_tokens. The
# application must also have AUTH0_CONNECTION enabled on it, or Auth0's
# emailed password reset (invites, admin reset links) fails.
#AUTH0_CLIENT_ID=
#AUTH0_CLIENT_SECRET=
# Database connection new users are created on.
#AUTH0_CONNECTION=Username-Password-Authentication
# [optional] Management API audience; empty derives https://<AUTH0_DOMAIN>/api/v2/.
#AUTH0_AUDIENCE=
# Keycloak's own e-mail (verification, password reset). Applied to the realm
# by `scripts/vegaduta up` (deploy/keycloak/reconcile-keycloak.sh). [optional]
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_DISPLAY=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=true
# "Sign in with Google/GitHub/Microsoft". Redirect URI to register with the
# provider: <PUBLIC_AUTH_URL>/realms/<KEYCLOAK_REALM>/broker/<google|github|microsoft>/endpoint
# [optional]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Links in the login page footer. [optional]
THEME_PRIVACY_URL=
THEME_TERMS_URL=
THEME_HELP_URL=

# ----------------------------------------------------------------------------
# 7. Object storage (full stack; lite stores files on a local volume)
# ----------------------------------------------------------------------------
# Default: bundled SeaweedFS S3 gateway. Bring your own S3 (AWS, R2, Ceph,
# Garage, MinIO...) by setting STORAGE_ENDPOINT and the keys it expects.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vegaduta
# true for most self-hosted S3; false for AWS virtual-hosted / Cloudflare R2.
STORAGE_PATH_STYLE_ACCESS=true
# [secret]
STORAGE_ACCESS_KEY=
# [secret]
STORAGE_SECRET_KEY=

# ----------------------------------------------------------------------------
# 8. Internal service-to-service secrets (each shared by exactly two services)
# ----------------------------------------------------------------------------
# [secret] core/voice-agent <-> sidecar
SIDECAR_SHARED_SECRET=
# [secret] core/app-builder <-> code-intel
CODE_INTEL_INTERNAL_TOKEN=
# [secret] core <-> tool-sandbox
TOOL_SANDBOX_INTERNAL_TOKEN=
# [secret] core <-> mcp-stdio-runner
MCP_STDIO_SIDECAR_SHARED_SECRET=
# [optional] Shared secret for the installer's host bridge (GET /api/addons/host/wanted,
# POST /api/addons/host/report). At least 32 characters (openssl rand -hex 32); empty keeps
# the bridge off - switching an add-on then only shows the command to run.
#ADDONS_HOST_TOKEN=
# Personal/lite mode --profile workspace: the Assistant's build container (services/workspace-runner).
# The secret is generated by `scripts/vegaduta secrets`; leave it empty here.
WORKSPACE_RUNNER_SECRET=
# Where project folders live on this computer (default ~/VegaDuta-Projects).
VEGADUTA_PROJECTS_DIR=
# WORKSPACE_RUNNER_MAX_TIMEOUT_SECONDS=1800
# WORKSPACE_RUNNER_MEM_LIMIT=3g
# [secret] app-builder -> core LLM routing
APP_BUILDER_CORE_SERVICE_TOKEN=
# [secret] Fernet key encrypting tenants' GitHub tokens in app-builder.
# Rotating it forces every tenant to reconnect GitHub.
APP_BUILDER_ENCRYPTION_KEY=
# [optional] extra X-Internal-Token accepted by app-builder.
APP_BUILDER_INTERNAL_TOKEN=
# [secret] core -> rl-trainer
RL_TRAINER_INTERNAL_TOKEN=
# [secret] Alertmanager -> core alert webhook
PLATFORM_ALERTS_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 9. Feature switches that pair with compose profiles
#    (the CLI sets these automatically from the profiles you enable)
# ----------------------------------------------------------------------------
# Appended to core's Spring profiles, e.g. ",workflow" (events) or
# ",workflow,temporal" (temporal). `workflow` requires a Kafka broker.
CORE_PROFILES_EXTRA=
# Set to ",shape-api" together with the `jobs` compose profile (core-jobs): the
# API then skips the sweeps and pollers core-jobs runs. Leave empty without
# core-jobs, or no process runs the background work.
CORE_SHAPE_PROFILE=
# legacy | temporal
WORKFLOW_EXECUTION_ENGINE=legacy
# profile code-intel
CODE_INTEL_ENABLED=false
# profile sandbox
TOOL_SANDBOX_ENABLED=false
# Container runtime for tool-sandbox (tenant code). runc shares the host
# kernel; install gVisor and set runsc for a user-space kernel. [optional]
TOOL_SANDBOX_RUNTIME=runc
# profiles tools / browser / sandbox: STDIO MCP servers run in mcp-stdio-runner
MCP_STDIO_SIDECAR_ENABLED=false
# ",mcp" = the built-in STDIO MCP servers (needs the runner above, or core-full)
CORE_MCP_PROFILE=
# Activepieces community pieces (services/piece-host) as MCP tools. Only takes
# effect with deploy/compose/docker-compose.piece-host.yml (build steps in its
# header) and MCP_STDIO_SIDECAR_ENABLED=true. Per-piece credentials are not set
# here: each tenant registration carries its own PIECE_AUTH_* values. [optional]
#MCP_PIECE_HOST_ENABLED=true
#PIECE_HOST_NODE_IMAGE=node:24.21.0-trixie-slim
# Self-hosted web search (SearXNG) for web_search / deep_research. Only takes
# effect with deploy/compose/docker-compose.search.yml and --profile search.
# SEARXNG_SECRET: generated by `scripts/vegaduta secrets` (openssl rand -hex 32);
# required by the search profile. [optional otherwise]
#SEARXNG_SECRET=
#WEB_SEARCH_PROVIDER=searxng
#WEB_SEARCH_FALLBACK=
#WEB_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
# "Six for everyone" feature flags, all off by default (see docs/configuration.md
# for what each needs). Set to true to turn on. [optional]
APP_TUTOR_ENABLED=false
APP_TUTOR_REMINDERS_ENABLED=false
RESEARCH_DEEP_ENABLED=false
RESEARCH_RUNS_ENABLED=false
APP_SANDBOX_DATA_ANALYSIS_ENABLED=false
APP_SANDBOX_PLATFORM_E2B_ENABLED=false
WHATSAPP_TEMPLATES_ENABLED=false
WORKFLOW_DRAFT_SIMULATE_SENDS=false
GRAPH_MEMORY_USER_FORGET_SYNC_ENABLED=false
# The Assistant's features (/assistant exists on every install; the agent behind it
# is per user). Lite ships these ON; on the full stack chat history is on and the
# rest are off unless set true here - they hold on shared installs for the reasons
# docs/configuration.md gives.
#   routines ("every morning, ..."), one run per tenant at a time
#SCHEDULED_TASKS_ENABLED=false
#   chat history kept in Postgres for 30 days instead of fading after 24 h, with
#   editable/regenerable threads; set false to switch it off
#APP_CHAT_BRANCHING_ENABLED=true
#   answers that survive a page reload (memory store: a resume must reach the
#   generating replica; APP_CHAT_RESUMABLE_STREAMS_STORE=redis for 2+ replicas)
#APP_CHAT_RESUMABLE_STREAMS_ENABLED=false
#   spreadsheet-like tables the Assistant fills (needs Flyway V615+)
#DATA_TABLES_ENABLED=false
#   skills/memory the Assistant drafts from use, pending approval (/learn)
#APP_SKILLS_LEARNING_ENABLED=false
#APP_LEARNING_PROPOSALS_ENABLED=false
# The agent's browser tool families once a browser exists (full stack: profile
# browser or CORE_IMAGE_VARIANT=-full; single-box tiers: --browser). Lite ships
# these ON; the full stack defaults them off.
#BROWSER_V2_ENABLED=false
#BROWSER_PROFILES_ENABLED=false
#BROWSER_TAKEOVER_ENABLED=false
# On a self-hosted box, tenant admins may switch add-ons without the platform
# admin (the registry is install-wide). Empty = platform admin only.
#APP_ADDONS_TENANT_ADMIN_MAY_CHANGE=true
# "-browser" = mcp-stdio-runner-browser image (profile browser)
MCP_STDIO_RUNNER_VARIANT=
# Build overlay only: true builds the browser runner variant.
MCP_STDIO_RUNNER_WITH_BROWSERS=false
# "-full" = core-full image (in-core Node/uv/browsers, ~6 GB) instead of the
# slim core. Build overlay: set CORE_MCP_TOOLCHAIN=full with it.
# Personal mode: "-full" is also the browser add-on - it ships the Chromium the agent's browser
# needs (browser_* tools, sign-in takeover, saved logins; those flags are already on in the
# personal profile). Also set CORE_MEM_LIMIT=2560m and the sites the agent may sign in to:
#   BROWSER_ALLOWED_DOMAINS=github.com,*.github.com
# The lighter route (personal mode): `scripts/vegaduta personal --browser` adds the browser-runner
# container (deploy/compose/browser.yml) and core stays slim. VEGADUTA_BROWSER=1 does the same from here;
# BROWSER_RUNNER_MEM_LIMIT (default 2g) caps it; APP_BROWSERUSE_REMOTE_URL (default
# ws://browser-runner:3000/) is where core finds it. [optional]
VEGADUTA_BROWSER=
BROWSER_RUNNER_MEM_LIMIT=
CORE_IMAGE_VARIANT=
CORE_MCP_TOOLCHAIN=none
# Override core's whole Spring profile list (advanced). [optional]
SPRING_PROFILES_ACTIVE=
# Lite-mode Spring profiles (advanced). Add ",mcp" for the built-in STDIO MCP
# tools - on lite they run in mcp-stdio-runner (--profile tools) or, with
# CORE_IMAGE_VARIANT=-full, spawn inside core itself.
LITE_SPRING_PROFILES=security,knowledge,graph-memory,lite

# ----------------------------------------------------------------------------
# 10. Temporal (profile temporal / jobs)
# ----------------------------------------------------------------------------
TEMPORAL_DB_USER=temporal
# [secret]
TEMPORAL_DB_PASSWORD=

# ----------------------------------------------------------------------------
# 11. Voice (profile voice)
# ----------------------------------------------------------------------------
# [secret] LiveKit API key/secret shared by livekit, core and voice-agent.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# UDP media range for the voice profile (host and container ports are identical). Move it when another process holds a
# port in the default 50000-50100 (the `up` pre-flight fails with `address already in use` otherwise).
# LIVEKIT_RTC_PORT_RANGE_START=50000
# LIVEKIT_RTC_PORT_RANGE_END=50100
# Bind LiveKit's media ports on all interfaces (0.0.0.0) when remote users call in.
LIVEKIT_BIND_ADDR=127.0.0.1
# TTS/STT vendors for the voice agent. [optional]
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
VOICE_AGENT_TTS_PROVIDER=auto

# ----------------------------------------------------------------------------
# 12. Observability (profile observability)
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# [secret]
GRAFANA_ADMIN_PASSWORD=
# Alert e-mail (both TO and HOST set = on). [optional]
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# 13. LLM tracing (profile tracing — self-hosted Langfuse)
# ----------------------------------------------------------------------------
# 0.0 = off. Set e.g. 0.1 once the tracing profile is running.
TRACING_SAMPLING_PROBABILITY=0.0
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_S3_ACCESS_KEY=langfuse
# [secret] x8
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_S3_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# Derived by the installer: "Basic " + base64(public_key:secret_key).
LANGFUSE_OTEL_AUTH_HEADER=
# First Langfuse UI login. [optional; password generated]
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=

# ----------------------------------------------------------------------------
# 14. Outbound e-mail from core (invites, notifications) [optional]
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# 15. Optional service settings
# ----------------------------------------------------------------------------
# rl-trainer's optimiser/judge model key (LLM providers for agents are
# configured in the web console, not here). [optional]
ANTHROPIC_API_KEY=
# Git token for re-indexing private repos in code-intel. [optional]
CODE_INTEL_GIT_TOKEN=
# Allow code-intel to execute repo commands (in its dind sandbox).
CODE_INTEL_ALLOW_EXEC=false
# Lite only: require new users to verify their email. Off by default in lite because it has no
# SMTP, and a required verification would end the first sign-up on "Failed to send email".
# Set true once Keycloak can send mail. The full stack always requires it. [optional]
#KEYCLOAK_REQUIRE_EMAIL_VERIFICATION=false
# Web console flags.
WEB_FREE_MODE=1
# 1 = on-device models in the browser (/edge). Nothing downloads without a click.
WEB_EDGE_AGENTS=1
WEB_DEPLOY_ENV=
# 1 = show plans, prices, upgrade and billing UI in the web console
# (hosted SaaS only). Empty = off, the self-hosted default. Feeds
# NEXT_PUBLIC_BILLING_ENABLED on web. [optional]
WEB_BILLING_ENABLED=
# Public (signed-out) pages: empty or "oss" = technical open-source pages with
# no pricing or sales content (default); "classic" = the original marketing
# pages. Feeds NEXT_PUBLIC_SITE_MODE on web. [optional]
WEB_SITE_MODE=
# Absolute URL of the published documentation site (for example
# https://<owner>.github.io/vegaduta/). Empty = the console's "Docs" links go to the
# in-app help at /docs. Feeds NEXT_PUBLIC_DOCS_URL on web. [optional]
WEB_DOCS_URL=
# Absolute URL of a hosted/commercial offering of this software. When set, the open-source
# pages show a "Hosted version" link to it. Empty = no such link. Feeds
# NEXT_PUBLIC_COMMERCIAL_URL on web. [optional]
WEB_COMMERCIAL_URL=
# 1 = render sandboxed MCP Apps (ui:// resources) in chat. Empty = off. Feeds
# NEXT_PUBLIC_MCP_APPS. [optional]
WEB_MCP_APPS=
# 1 = the chat artifacts side pane (sandboxed preview, versions, copy/download).
# Empty = off. Feeds NEXT_PUBLIC_ARTIFACTS. [optional]
WEB_ARTIFACTS=
# Extra hosts model-rendered markdown images may load from, comma-separated;
# an entry starting with "." also matches subdomains (".example.com"). The API
# and site origins are always trusted. Feeds NEXT_PUBLIC_TRUSTED_IMAGE_HOSTS. [optional]
WEB_TRUSTED_IMAGE_HOSTS=

# ----------------------------------------------------------------------------
# 16. Resource limits (defaults fit 16 GB for full, 8 GB for lite)
# ----------------------------------------------------------------------------
CORE_MEM_LIMIT=
SIDECAR_MEM_LIMIT=
POSTGRES_MEM_LIMIT=
KEYCLOAK_MEM_LIMIT=
# Docker-in-docker daemon of the code-intel profile (runs tenant code): memory
# ceiling and process cap (defaults 4g / 2048).
#CODE_INTEL_DOCKER_MEM_LIMIT=
#CODE_INTEL_DOCKER_PIDS_LIMIT=
#SEARXNG_MEM_LIMIT=

# Anything else core understands (any Spring property as an env var — e.g.
# GOOGLE_OAUTH_CLIENT_ID, VERTEX_ENABLED, billing keys) goes in
# deploy/compose/core.env, which is loaded into core/core-worker/core-jobs
# when present.

# Private hosts that tenant-configured outbound calls (BYOK endpoints, OpenAPI
# sources, A2A peers, webhooks) may reach, comma-separated host or host:port.
# Needed for a self-hosted Ollama on the Compose network, e.g. ollama:11434.
# See docs/configuration.md "Security hardening settings". [optional]
#APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS=
# Optional: restrict tenant-configured outbound URLs to these hosts (host or *.suffix, comma-separated).
#APP_SECURITY_OUTBOUND_EGRESS_ALLOW_LIST=
# Free local model (scripts/vegaduta up --local-ai; docs/local-models.md).
# The CLI sets the allow-list entry and base URL for you; these override.
# Any tag from the shared catalog works - `scripts/vegaduta models list`
# shows them (qwen3.5, gpt-oss, deepseek-r1, ...). With no value here the
# Ollama container's memory cap follows the catalog's RAM column.
#LOCAL_LLM_MODEL=qwen3.5:4b
#OLLAMA_MEM_LIMIT=8g
# Context window (tokens) for the local model; blank = chosen from Docker's memory (8192 under 6 GB, 16384 under 10 GB, else 32768).
#LOCAL_LLM_NUM_CTX=
# Reasoning effort sent to the local model: none (default, fastest: no hidden thinking pass), low, medium, high. Blank also means none (the local-ai overlay reads it as ${LOCAL_LLM_REASONING_EFFORT:-none}).
#LOCAL_LLM_REASONING_EFFORT=none
# How long Ollama keeps the model in memory after a reply; -1 (default) = always, so no cold start. Use 10m to free memory when idle.
#OLLAMA_KEEP_ALIVE=-1

# Register a local Ollama (or any OpenAI-compatible local server) as the FREE-tier
# platform pool at startup, no API calls needed. The host must also be listed in
# APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS (e.g. ollama:11434) and the model
# pulled (`ollama pull qwen3.5:4b`). Leave API_KEY unset for the harmless default,
# set it empty for a keyless row. See docs/configuration.md "Local LLM pool bootstrap". [optional]
#APP_LOCAL_LLM_BOOTSTRAP_ENABLED=false
#APP_LOCAL_LLM_BOOTSTRAP_BASE_URL=http://ollama:11434
#APP_LOCAL_LLM_BOOTSTRAP_MODEL=qwen3.5:4b
#APP_LOCAL_LLM_BOOTSTRAP_LABEL=Local model (Ollama)
#APP_LOCAL_LLM_BOOTSTRAP_API_KEY=

# Personal mode (scripts/vegaduta personal; docs/personal-mode.md). Nothing here is
# required: the CLI generates the secrets, and every value below has a default. [optional]
# Spring profiles of core (default security,knowledge,graph-memory,personal).
#PERSONAL_SPRING_PROFILES=
# Extra JVM flags for core, appended last, e.g. -Xmx700m.
#PERSONAL_JAVA_OPTS_EXTRA=
# true + `personal --build`: build the core image with an AppCDS archive (faster boot).
#PERSONAL_AOT_CACHE=false
# Console sign-in mode passed to web as NEXT_PUBLIC_AUTH_MODE (local = no Keycloak).
#WEB_AUTH_MODE=local
# Day-one defaults of a FRESH personal install: private web search (a SearXNG container, no API key) and the
# MCP runner (a container for connector servers; fetch and time are registered on the Tools page). Opt out
# here (0) or with `scripts/vegaduta personal --no-search --no-tools`, which is remembered; 1 forces them on.
# An install that already existed keeps what it had. The runner is not used with --native-core.
#VEGADUTA_SEARCH=0
#VEGADUTA_TOOLS=0
# 0 leaves the Valkey container out of a personal install (the same as
# `personal --no-valkey`); core's counters and rate limits then run in its
# bounded in-process fallback. Personal only - lite/full keep Valkey always.
#VEGADUTA_VALKEY=0
# MCP runner limits (laptop-sized): memory of the container and how many connector servers may run at once.
#MCP_STDIO_RUNNER_MEM_LIMIT=768m
#MCP_STDIO_RUNNER_MAX_CHILDREN=8
# false = register no starter connectors even when the runner is on.
#APP_MCP_STARTER_ENABLED=true
# STDIO MCP sandbox of the CONTAINER core (none | container). The `os` level needs
# macOS or bubblewrap, so use `personal --native-core` for it. See docs/personal-mode.md.
#APP_MCP_STDIO_SANDBOX=none
# Host hardware the containerised core cannot see: RAM in GB, and the accelerator
# ("apple", or "nvidia:NAME:VRAM_GB"). `personal` detects and persists both here;
# exported env or a hand-set value always wins over the detection.
#HOST_RAM_GB=
#HOST_ACCELERATOR=
# Ask before every local_shell command (true) or let the sandboxed terminal run without
# a per-call approval card (false - this profile's default; supervised agents still ask).
#APP_ASSISTANT_LOCAL_SHELL_APPROVAL_REQUIRED=false
# Desktop tools (local_desktop_*): point core at the desktop-agent you run ON the laptop
# (node services/desktop-agent/server.js). Unconfined GUI actions - approval defaults to
# off on personal; set true to approve each click/type. host.docker.internal for Docker core.
#APP_ASSISTANT_DESKTOP_AGENT_URL=http://host.docker.internal:8787
#APP_ASSISTANT_DESKTOP_AGENT_SECRET=
#APP_ASSISTANT_DESKTOP_APPROVAL_REQUIRED=false
# Recurring unattended agent runs ("check my mail every morning") - on in this profile.
#SCHEDULED_TASKS_ENABLED=true
# Which delivery channels a scheduled task may use (default enables all):
# in_app,email,whatsapp,whatsapp_qr,telegram,slack,signal,matrix,imessage,a2a,voice
# a2a hands the result to a remote agent (needs APP_A2A_CLIENT_ENABLED=true + allow-listed hosts);
# voice places an outbound call that speaks the result (needs the tenant's Twilio voice credential).
#SCHEDULED_TASKS_DELIVERY_CHANNELS=in_app,email,whatsapp,whatsapp_qr,telegram,slack,signal,matrix,imessage,a2a,voice
# Memory limits of the personal containers (defaults 384m / 1536m / 384m).
#WEB_MEM_LIMIT=
# --native-core: host JVM heap, jar to run, state directory, Ollama address.
#VEGADUTA_CORE_HEAP=1g
#VEGADUTA_CORE_JAR=
#VEGADUTA_PERSONAL_HOME=
#LOCAL_LLM_BASE_URL_NATIVE=http://127.0.0.1:11434
# Loopback ports postgres/valkey publish for --native-core.
#POSTGRES_HOST_PORT=5432
#VALKEY_HOST_PORT=6379

# Signal channel (deploy/compose/signal.yml, profile `signal`; docs/channels/signal.md).
# signal-cli has no authentication of its own: it publishes no port. Also add
# signal-cli:8080 to APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS above. [optional]
#SIGNAL_CLI_IMAGE=bbernhard/signal-cli-rest-api:0.96
# json-rpc (websocket receive, default) or normal (poll).
#SIGNAL_CLI_MODE=json-rpc

# WhatsApp QR channel (deploy/compose/whatsapp-qr.yml, profile `whatsapp-qr`;
# docs/channels/whatsapp-qr.md): link your own WhatsApp number as a companion
# device - the WhatsApp path that works on a laptop (outbound only). One shared
# secret reaches BOTH the bridge (WHATSAPP_QR_BRIDGE_SECRET) and core
# (APP_WHATSAPPQR_BRIDGE_SECRET); `scripts/vegaduta secrets` generates it. Also add
# whatsapp-qr:8080 to APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS above.
#WHATSAPP_QR_BRIDGE_SECRET=
#APP_WHATSAPPQR_BRIDGE_URL=http://whatsapp-qr:8080
#APP_WHATSAPPQR_BRIDGE_SECRET=
#WHATSAPP_QR_MEM_LIMIT=384m

# ----------------------------------------------------------------------------
# 17. DefectDojo findings dashboard (optional, maintainer tooling)
# ----------------------------------------------------------------------------
# Standalone stack: docker compose -f deploy/compose/defectdojo.yml
#   --env-file deploy/compose/.env up -d --wait   → http://localhost:8082
# Aggregates the CI scanners' reports (Trivy, ZAP, grype, ScanCode); see
# docs/security/scanning.md. `scripts/vegaduta secrets` generates the four secrets.
#DD_ADMIN_PASSWORD=
#DD_SECRET_KEY=
#DD_CREDENTIAL_AES_256_KEY=
#DD_DATABASE_PASSWORD=
#DD_HOST_PORT=8082
#DD_VERSION=3.4.100
#DD_ALLOWED_HOSTS=localhost,127.0.0.1
#DD_SITE_URL=http://localhost:8082
