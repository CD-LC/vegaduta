# =============================================================================
# VegaDūta — deploy/compose/core.env
#
# Environment for the core containers only (core, core-jobs, core-worker):
# docker-compose.yml loads this file into those services when it exists
# (`env_file: ./core.env`, required: false). Anything Spring can read as an
# environment variable belongs here rather than in .env, whose values are for
# compose-level wiring and the other containers.
#
# Copy this file to core.env and fill in what you use; leave the rest absent
# or empty — empty values keep the feature off. Never commit real values.
#
# Conventions: [secret] = a credential; [optional] = feature stays off when
# blank. Full reference: docs/configuration.md.
# =============================================================================

# ----------------------------------------------------------------------------
# JVM
# ----------------------------------------------------------------------------
#JAVA_TOOL_OPTIONS=-Xmx2g

# ----------------------------------------------------------------------------
# Billing gateways (needs WEB_BILLING_ENABLED=1 in .env for the console UI)
# ----------------------------------------------------------------------------
# Which gateway a checkout uses when the caller does not name one:
# razorpay (default) | stripe | phonepe. [optional]
#DEFAULT_PAYMENT_GATEWAY=razorpay

# Stripe — subscriptions via hosted invoice checkout; webhook HMAC verification
# fails closed while STRIPE_WEBHOOK_SECRET is empty. [optional, secret]
#STRIPE_SECRET_KEY=
#STRIPE_PUBLISHABLE_KEY=
#STRIPE_WEBHOOK_SECRET=
# Stripe Price ids the plan names PREMIUM/UNLIMITED resolve to at checkout.
#STRIPE_PRICE_ID_PREMIUM=
#STRIPE_PRICE_ID_UNLIMITED=
#STRIPE_API_BASE_URL=https://api.stripe.com

# Razorpay — the default gateway. [optional, secret]
#RAZORPAY_KEY_ID=
#RAZORPAY_KEY_SECRET=
#RAZORPAY_WEBHOOK_SECRET=
#RAZORPAY_PLAN_ID_STARTER=
#RAZORPAY_PLAN_ID_BUSINESS=
#RAZORPAY_TRIAL_DAYS=14

# PhonePe — only active under the `security` Spring profile. [optional, secret]
#PHONEPE_OAUTH_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
#PHONEPE_API_BASE_URL=
#PHONEPE_CLIENT_ID=
#PHONEPE_CLIENT_SECRET=
#PHONEPE_CLIENT_VERSION=1
#PHONEPE_MERCHANT_ID=
#PHONEPE_WEBHOOK_USERNAME=
#PHONEPE_WEBHOOK_PASSWORD=
#PHONEPE_PLAN_PREMIUM=
#PHONEPE_PLAN_UNLIMITED=

# ----------------------------------------------------------------------------
# Identity provider (admin-side user management)
# ----------------------------------------------------------------------------
# Which IdP admin adapter core uses: keycloak (default; the bundled
# container) | auth0. [optional]
#IDENTITY_PROVIDER=keycloak
# Auth0 Management API credentials - only read when IDENTITY_PROVIDER=auth0.
# A Machine-to-Machine application authorized against the Management API;
# see docs/configuration.md for the scopes it needs. [optional, secret]
#AUTH0_DOMAIN=
#AUTH0_CLIENT_ID=
#AUTH0_CLIENT_SECRET=
#AUTH0_CONNECTION=Username-Password-Authentication
#AUTH0_AUDIENCE=

# ----------------------------------------------------------------------------
# Outbound integrations
# ----------------------------------------------------------------------------
# Google Workspace OAuth tools (Calendar, Drive, Gmail, ...). [optional, secret]
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# Google Vertex AI provider. [optional]
#VERTEX_ENABLED=
#VERTEX_PROJECT=
#VERTEX_LOCATION=

# ----------------------------------------------------------------------------
# Temporal (compose profile `temporal`; durable workflow engine)
# ----------------------------------------------------------------------------
#TEMPORAL_TARGET=temporal:7233
#TEMPORAL_NAMESPACE=default
#WORKFLOW_KAFKA_BOOTSTRAP_SERVERS=

# ----------------------------------------------------------------------------
# Personal mode (scripts/vegaduta personal; docs/personal-mode.md)
# ----------------------------------------------------------------------------
# The CLI writes these itself; the block exists so a hand-maintained core.env
# can do the same. All optional - personal defaults are in application-personal.yml.
#SPRING_PROFILES_ACTIVE=security,knowledge,graph-memory,personal
# Local password sign-in instead of Keycloak:
#APP_AUTH_LOCAL_ENABLED=true
#WEB_AUTH_MODE=local
# Public origin of the console (browser-facing; never hardcode localhost in prod):
#APP_WEB_PUBLIC_URL=http://localhost:3000
# Outbound SSRF guard: private hosts a tool is allowed to reach, comma-separated
# (e.g. a self-hosted SearXNG or a local Ollama not on the default list).
#APP_SECURITY_OUTBOUND_ALLOWED_PRIVATE_HOSTS=
# E2E runs on a local stack: signup must tolerate the suite's bulk fresh-tenant
# signups and the mailinator inboxes it reads for Keycloak verification.
# Do NOT set these in production.
# SIGNUP_DISPOSABLE_EMAIL_BLOCK_ALLOWLIST=mailinator.com
# SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=100
