      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "**Metric-name dependency notice** (alerting infrastructure pass, 2026-07): every panel below queries `llm_calls_total`, `llm_call_errors_total`, `llm_budget_rejections_total`, and `llm_call_cost_usd_total`. None of these Micrometer metrics exist in this codebase as of this pass - `LlmMetricsAdvisor` (core/chat) today only reports to an in-memory counter and the durable `llm_call_log` table, neither of which is a Prometheus meter. These names are this pass's best-effort prediction of what a concurrent workstream instrumenting that advisor would call them (Micrometer's dot-to-underscore + `_total` counter convention applied to `llm.calls`/`llm.call.errors`/`llm.budget.rejections`/`llm.call.cost.usd`). **Every panel here will show \"No data\" until that instrumentation actually lands** - verify the real metric names against whatever ships and edit the queries below to match if they differ.",
        "mode": "markdown"
      },
      "pluginVersion": "11.3.1",
      "title": "Dependency notice - read before trusting this dashboard",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "panels": [],
      "title": "LLM call volume & error rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "LLM call rate, one series per tenant. Depends on llm_calls_total{tenant,...} - see dependency notice above.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
