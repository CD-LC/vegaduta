  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "Single pane of glass for on-call: what's actively firing (from real Alertmanager, via the new `Alertmanager` datasource), plus the raw metrics behind the alert rules most likely to page (`deploy/prometheus/rules/vegaduta-alerts.yml`). If the **Active Alerts** panel below shows nothing despite something clearly being wrong, check `docker compose logs alertmanager` and confirm the `Alertmanager` datasource (provisioned in `deploy/grafana/provisioning/datasources/alertmanager.yaml`) is reachable - the exact Grafana JSON wiring for an *external* Alertmanager into the native Alert list panel varies by Grafana version and was not verified against a live instance in this pass; the **Alerts (Prometheus ALERTS metric)** table below queries the same data a guaranteed-correct way (Prometheus's own synthetic `ALERTS{alertstate=...}` series) as a fallback that needs no panel-schema guessing.",
        "mode": "markdown"
      },
      "pluginVersion": "11.3.1",
      "title": "How to read this dashboard",
      "type": "text"
    },
    {
      "datasource": { "type": "alertmanager", "uid": "alertmanager" },
      "description": "Native Grafana panel querying the real Alertmanager (docker-compose.yml's alertmanager service) directly for currently firing/pending alerts - best-effort wiring, see the notice above if it renders empty.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 40,
        "sortOrder": 1,
        "stateFilter": { "error": true, "firing": true, "noData": false, "normal": false, "pending": true },
        "viewMode": "list"
      },
      "pluginVersion": "11.3.1",
      "title": "Active Alerts (Alertmanager)",
      "type": "alertlist"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Guaranteed-correct fallback/companion to the panel on the left - Prometheus's own synthetic ALERTS series, populated the instant a rule in vegaduta-alerts.yml starts firing or pending, independent of Alertmanager delivery.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "alertstate" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "firing": { "color": "red", "index": 0, "text": "FIRING" } } },
                  { "type": "value", "options": { "pending": { "color": "yellow", "index": 1, "text": "PENDING" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 3 },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "severity" }]
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "ALERTS{alertstate=~\"firing|pending\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Alerts (Prometheus ALERTS metric) - fallback view",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
