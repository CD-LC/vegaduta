<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.cd-lc</groupId>
    <artifactId>vegaduta-agent-parent</artifactId>
    <version>0.1.1</version>
  </parent>

  <artifactId>vegaduta-agent-core</artifactId>
  <name>VegaDuta Agent SDK :: Core</name>
  <description>
    Reference implementations of the governance contracts: policy dispatch gate, lethal-trifecta
    detector, in-memory approval gate with four-eyes rule, atomic reserve-then-commit budget,
    effect journal, pattern guardrails, hook engine, audit sinks, Micrometer and OpenTelemetry
    observers, and the GovernedTool pipeline that composes them.
  </description>

  <properties>
    <automatic.module.name>io.vegaduta.agent.core</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.cd-lc</groupId>
      <artifactId>vegaduta-agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Linear-time regular expressions: a guardrail must never be a ReDoS vector. -->
    <dependency>
      <groupId>com.google.re2j</groupId>
      <artifactId>re2j</artifactId>
    </dependency>
    <!-- Optional observers. Only loaded when the host wires them in. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
