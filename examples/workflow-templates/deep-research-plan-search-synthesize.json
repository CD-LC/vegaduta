      {
        "id": "trigger-1",
        "type": "trigger",
        "position": { "x": 0, "y": 0 },
        "data": {
          "label": "Manual trigger - input is the research question",
          "config": {}
        }
      },
      {
        "id": "agent-planner",
        "type": "agent",
        "position": { "x": 280, "y": 0 },
        "data": {
          "label": "Research planner",
          "config": {
