{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "tests-prod/**/*.ts",
    "helpers/**/*.ts",
    "playwright.config.ts",
    "playwright.prod.config.ts",
    "playwright.personal.config.ts"
  ]
}
